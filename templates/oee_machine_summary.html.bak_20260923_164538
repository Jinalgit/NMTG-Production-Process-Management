    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ts);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition:
      color 0.15s,
      border-color 0.15s;
  }
  .oees-tab-btn:hover {
    color: var(--tp);
  }
  .oees-tab-btn.active {
    color: var(--ac);
    border-bottom-color: var(--ac);
    background: var(--card);
  }
  .oees-tab-btn .oees-count {
    background: var(--rl);
    border: 1px solid var(--bd);
    color: var(--ts);
    font-size: 10px;
    font-weight: 700;
    padding: 1px 7px;
    border-radius: 10px;
  }
  .oees-tab-btn.active .oees-count {
    background: #eaf1f9;
    color: var(--ac);
    border-color: #cfe0f2;
  }
  .oees-merged-hide {
    display: none !important;
  }
</style>
<script>
  /* OEES_TABS_INJECT_V1 — merges Top Losses + Activities + Tool Entries into one tabbed card */
(function () {
  function init() {
    var lossTbl = document.getElementById("tbl-losses");
    var actTbl  = document.getElementById("tbl-activities");
    var tolTbl  = document.getElementById("tbl-tools");
    if (!actTbl || !tolTbl) return;

    var lossCard = lossTbl ? lossTbl.closest(".oees-card") : null;
    var actCard  = actTbl.closest(".oees-card");
    var tolCard  = tolTbl.closest(".oees-card");
    if (!actCard || !tolCard) return;
    if (actCard.dataset.tabsInit === "1") return;
    actCard.dataset.tabsInit = "1";

    // Build 3-tab bar; Top Losses is default active
    var head = actCard.querySelector(".oees-card-head");
    var bar = document.createElement("div");
    bar.className = "oees-tabbar";
    bar.innerHTML =
      '<button type="button" class="oees-tab-btn active" data-pane="loss">' +
        '<i class="fa fa-exclamation-triangle"></i> Top Losses ' +
        '<span class="oees-count" id="c-losses-tab">0</span>' +
      '</button>' +
      '<button type="button" class="oees-tab-btn" data-pane="act">' +
        '<i class="fa fa-cogs"></i> Activities ' +
        '<span class="oees-count" id="c-activities-tab">0</span>' +
      '</button>' +
      '<button type="button" class="oees-tab-btn" data-pane="tool">' +
        '<i class="fa fa-wrench"></i> Tool Entries ' +
        '<span class="oees-count" id="c-tools-tab">0</span>' +
      '</button>';
    if (head && head.parentNode) { head.parentNode.insertBefore(bar, head); head.style.display = "none"; }

    // Move Top Losses body in and mark original card hidden
    var lossBody = lossCard ? lossCard.querySelector(".oees-card-body") : null;
    if (lossBody) {
      lossBody.classList.add("oees-loss-pane");
      actCard.appendChild(lossBody);
      lossCard.classList.add("oees-merged-hide");
    }

    // Move Tool Entries body in and hide its old card
    var tolBody = tolCard.querySelector(".oees-card-body");
    if (tolBody) {
      tolBody.classList.add("oees-tool-pane");
      tolBody.hidden = true;
      actCard.appendChild(tolBody);
    }
    tolCard.classList.add("oees-merged-hide");

    // Activities body already in actCard
    var actBody = actCard.querySelector(".oees-card-body:not(.oees-tool-pane):not(.oees-loss-pane)");
    if (actBody) { actBody.classList.add("oees-act-pane"); actBody.hidden = true; }

    // Default active: Top Losses
    if (lossBody) lossBody.hidden = false;

    // Wire tab clicks
    bar.querySelectorAll(".oees-tab-btn").forEach(function (btn) {
      btn.addEventListener("click", function () {
        bar.querySelectorAll(".oees-tab-btn").forEach(function (b) { b.classList.remove("active"); });
        btn.classList.add("active");
        var p = btn.dataset.pane;
        if (lossBody) lossBody.hidden = (p !== "loss");
        if (actBody)  actBody.hidden  = (p !== "act");
        if (tolBody)  tolBody.hidden  = (p !== "tool");
      });
    });

    // Sync counts (strip trailing " rows" so tab shows only the number)
    function stripRows(s) { return String(s || "").replace(/\s*rows?\s*$/i, "").trim(); }
    function syncCounts() {
      var lossOld = document.getElementById("c-losses");
      var actOld  = document.getElementById("c-activities");
      var tolOld  = document.getElementById("c-tools");
      var lossTab = document.getElementById("c-losses-tab");
      var actTab  = document.getElementById("c-activities-tab");
      var tolTab  = document.getElementById("c-tools-tab");
      if (lossOld && lossTab) lossTab.textContent = stripRows(lossOld.textContent);
      if (actOld  && actTab)  actTab.textContent  = stripRows(actOld.textContent);
      if (tolOld  && tolTab)  tolTab.textContent  = stripRows(tolOld.textContent);
    }
    syncCounts();
    var obs = new MutationObserver(syncCounts);
    ["c-losses", "c-activities", "c-tools"].forEach(function (id) {
      var el = document.getElementById(id);
      if (el) obs.observe(el, { childList: true, characterData: true, subtree: true });
    });
    document.addEventListener("click", function (e) {
      if (e.target && e.target.closest && e.target.closest("#oees-apply, .oees-preset")) {
        setTimeout(syncCounts, 250);
      }
    });
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
})();
</script>

{% endblock %}
