<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="utf-8">

<meta
    name="viewport"
    content="width=device-width, initial-scale=1"
>

<title>
    {{ machine.machine_no }} - Machine OEE
</title>



<!-- MACHINE_OEE_RUNTIME_REPAIR_V7 -->

<link
    href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
    rel="stylesheet"
>

<link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"
>

<style>

:root {
    --bg:#f4f7fb;
    --panel:#ffffff;
    --ink:#172235;
    --muted:#6b7280;
    --line:#dfe5ed;
    --brand:#173d68;
    --blue:#2563eb;
    --green:#15803d;
    --soft-blue:#eef4ff;
}


* {
    box-sizing:border-box;
}


body {
    margin:0;

    background:var(--bg);

    color:var(--ink);

    font-family:
        "IBM Plex Sans",
        sans-serif;
}


.oee-shell {
    width:min(1120px, 96%);

    margin:0 auto;

    padding:22px 0 40px;
}


/* =========================================================
   HEADER
   ========================================================= */

.oee-topbar {
    display:flex;

    justify-content:space-between;
    align-items:center;

    gap:16px;

    margin-bottom:16px;
}


.back-link {
    display:inline-flex;

    align-items:center;

    gap:7px;

    text-decoration:none;

    color:#475569;

    font-size:12px;
    font-weight:800;
}


.back-link:hover {
    color:var(--blue);
}


.machine-chip {
    display:inline-flex;

    align-items:center;

    gap:8px;

    padding:9px 14px;

    background:var(--brand);

    border-radius:999px;

    color:white;

    font-size:12px;
    font-weight:900;
}


/* =========================================================
   MACHINE HEADER
   ========================================================= */

.machine-header {
    display:flex;

    justify-content:space-between;
    align-items:flex-start;

    gap:20px;

    padding:20px;

    background:white;

    border:1px solid var(--line);

    border-radius:14px;

    margin-bottom:15px;
}


.machine-title h1 {
    margin:0;

    font-size:24px;

    color:#172235;
}


.machine-title p {
    margin:5px 0 0;

    color:var(--muted);

    font-size:12px;
}


.machine-context {
    display:grid;

    grid-template-columns:
        repeat(3, minmax(110px,1fr));

    gap:8px;

    min-width:390px;
}


.context-box {
    padding:10px 12px;

    border:1px solid #e2e8f0;

    border-radius:9px;

    background:#f8fafc;
}


.context-box span {
    display:block;

    color:#64748b;

    font-size:9px;

    font-weight:900;

    text-transform:uppercase;

    letter-spacing:.04em;
}


.context-box strong {
    display:block;

    margin-top:4px;

    color:#172235;

    font-size:13px;

    font-weight:900;
}


/* =========================================================
   STATUS
   ========================================================= */

.machine-ready {
    display:flex;

    align-items:center;

    gap:10px;

    padding:12px 14px;

    margin-bottom:15px;

    background:#f0fdf4;

    border:1px solid #bbf7d0;

    border-radius:11px;

    color:#166534;

    font-size:12px;

    font-weight:800;
}


.ready-dot {
    width:9px;
    height:9px;

    flex:none;

    border-radius:50%;

    background:#22c55e;
}


/* =========================================================
   MAIN PLACEHOLDER
   ========================================================= */

.workspace-grid {
    display:grid;

    grid-template-columns:
        minmax(0,1fr)
        300px;

    gap:14px;

    align-items:start;
}


.card {
    background:white;

    border:1px solid var(--line);

    border-radius:14px;

    padding:18px;
}


.card-head {
    display:flex;

    align-items:center;

    justify-content:space-between;

    gap:10px;

    margin-bottom:14px;
}


.card-head h2 {
    margin:0;

    font-size:16px;
}


.tag {
    padding:5px 9px;

    border-radius:999px;

    background:var(--soft-blue);

    color:var(--blue);

    font-size:10px;

    font-weight:900;
}


/* =========================================================
   JC SEARCH
   ========================================================= */

.jc-label {
    display:block;

    color:#475569;

    font-size:10px;

    font-weight:900;

    text-transform:uppercase;

    letter-spacing:.04em;

    margin-bottom:6px;
}


.jc-search {
    display:grid;

    grid-template-columns:
        minmax(0,1fr)
        auto;

    gap:8px;
}


.jc-search input {
    width:100%;

    min-height:46px;

    border:1px solid #cbd5e1;

    border-radius:10px;

    padding:10px 13px;

    color:#172235;

    font-size:16px;

    font-weight:800;

    outline:none;
}


.jc-search input:focus {
    border-color:#2563eb;

    box-shadow:
        0 0 0 3px
        rgba(37,99,235,.10);
}


.jc-search button {
    min-width:95px;

    border:0;

    border-radius:10px;

    background:#173d68;

    color:white;

    font-weight:900;

    padding:10px 17px;

    cursor:not-allowed;

    opacity:.55;
}


.helper {
    margin-top:7px;

    color:#64748b;

    font-size:11px;
}


/* =========================================================
   RIGHT SIDE
   ========================================================= */

.machine-summary-title {
    margin:0 0 13px;

    font-size:14px;
}


.summary-row {
    display:flex;

    align-items:center;
    justify-content:space-between;

    gap:10px;

    padding:9px 0;

    border-bottom:1px solid #edf1f5;

    font-size:11px;
}


.summary-row:last-child {
    border-bottom:0;
}


.summary-row span {
    color:#64748b;
}


.summary-row strong {
    color:#172235;

    text-align:right;
}


.status-open {
    color:var(--green) !important;
}


/* =========================================================
   UPCOMING WORKSPACE
   ========================================================= */

.upcoming {
    margin-top:14px;

    border:1px dashed #cbd5e1;

    border-radius:11px;

    padding:18px;

    text-align:center;

    color:#94a3b8;

    background:#fafbfd;
}


.upcoming strong {
    display:block;

    color:#64748b;

    font-size:12px;

    margin-bottom:4px;
}


.upcoming span {
    font-size:10px;
}


/* =========================================================
   RESPONSIVE
   ========================================================= */

@media(max-width:850px) {

    .machine-header {
        flex-direction:column;
    }


    .machine-context {
        width:100%;

        min-width:0;
    }


    .workspace-grid {
        grid-template-columns:1fr;
    }

}


@media(max-width:560px) {

    .machine-context {
        grid-template-columns:1fr;
    }


    .jc-search {
        grid-template-columns:1fr;
    }


    .jc-search button {
        min-height:44px;
    }

}



/* MACHINE_OEE_JC_FETCH_V1_CSS */

.jc-result-v1 {
    margin-top:14px;
}


.jc-state-v1 {
    border:1px solid #dfe5ed;
    border-radius:11px;
    padding:14px;
    background:#fff;
}


.jc-state-v1.success {
    border-color:#bbf7d0;
    background:#f0fdf4;
}


.jc-state-v1.warning {
    border-color:#fed7aa;
    background:#fff7ed;
}


.jc-state-v1.error {
    border-color:#fecaca;
    background:#fef2f2;
}


.jc-state-head-v1 {
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:10px;
    margin-bottom:11px;
}


.jc-state-head-v1 strong {
    font-size:13px;
    color:#172235;
}


.jc-status-chip-v1 {
    padding:4px 8px;
    border-radius:999px;
    font-size:9px;
    font-weight:900;
    background:#e2e8f0;
    color:#475569;
}


.jc-state-grid-v1 {
    display:grid;
    grid-template-columns:
        repeat(3,minmax(0,1fr));
    gap:8px;
}


.jc-info-v1 {
    background:rgba(255,255,255,.72);
    border:1px solid rgba(203,213,225,.75);
    border-radius:8px;
    padding:9px 10px;
    min-width:0;
}


.jc-info-v1 span {
    display:block;
    color:#64748b;
    font-size:9px;
    text-transform:uppercase;
    font-weight:900;
}


.jc-info-v1 strong {
    display:block;
    margin-top:4px;
    color:#172235;
    font-size:12px;
    overflow:hidden;
    text-overflow:ellipsis;
}


.jc-action-v1 {
    margin-top:12px;
    display:flex;
    justify-content:flex-end;
    gap:8px;
}


.jc-action-v1 button {
    border:0;
    border-radius:9px;
    padding:9px 14px;
    font-weight:900;
    cursor:pointer;
}


.jc-receive-btn-v1 {
    background:#173d68;
    color:#fff;
}


.jc-ready-btn-v1 {
    background:#dcfce7;
    color:#166534;
    cursor:default !important;
}


.receive-qty-v1 {
    width:120px;
    min-height:38px;
    border:1px solid #cbd5e1;
    border-radius:8px;
    padding:7px 9px;
    font-weight:900;
}


.pending-machine-v1 {
    border:1px solid #fdba74;
    background:#fff7ed;
    border-radius:11px;
    padding:14px;
    margin-bottom:14px;
}


.pending-machine-v1 h3 {
    margin:0 0 9px;
    color:#9a3412;
    font-size:13px;
}


.pending-machine-v1 p {
    margin:0;
    color:#7c2d12;
    font-size:11px;
}


.machine-page-error-v1 {
    padding:11px 13px;
    border-radius:9px;
    border:1px solid #fecaca;
    background:#fef2f2;
    color:#991b1b;
    font-size:11px;
    font-weight:800;
}


@media(max-width:650px) {

    .jc-state-grid-v1 {
        grid-template-columns:1fr;
    }

}




/* MACHINE_OEE_START_RUN_V1_CSS */

.machine-shift-box-v1 {
    margin-bottom:14px;
    padding:12px 14px;

    border:1px solid #dfe5ed;
    border-radius:11px;

    background:#f8fafc;

    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:14px;
}


.machine-shift-box-v1 > div:first-child strong {
    display:block;

    color:#172235;
    font-size:12px;
}


.machine-shift-box-v1 > div:first-child small {
    display:block;

    margin-top:3px;

    color:#64748b;
    font-size:10px;
}


.machine-shift-select-v1 {
    min-width:150px;
    min-height:38px;

    border:1px solid #cbd5e1;
    border-radius:8px;

    padding:7px 9px;

    background:#fff;

    color:#172235;
    font-weight:800;
}


.machine-start-btn-v1 {
    border:0 !important;

    border-radius:9px !important;

    background:#173d68 !important;

    color:#fff !important;

    padding:10px 15px !important;

    font-weight:900 !important;

    cursor:pointer !important;
}


.machine-running-v1 {
    padding:15px;

    border:1px solid #93c5fd;
    border-radius:11px;

    background:#eff6ff;
}


.machine-running-head-v1 {
    display:flex;

    justify-content:space-between;
    align-items:center;

    gap:10px;

    margin-bottom:11px;
}


.machine-running-head-v1 strong {
    color:#1e3a8a;

    font-size:13px;
}


.machine-running-chip-v1 {
    padding:5px 9px;

    border-radius:999px;

    background:#dbeafe;

    color:#1d4ed8;

    font-size:9px;
    font-weight:900;
}


@media(max-width:560px) {

    .machine-shift-box-v1 {
        flex-direction:column;
        align-items:stretch;
    }

    .machine-shift-select-v1 {
        width:100%;
    }
}




/* MACHINE_OEE_PRODUCTION_ENTRY_V1_CSS */

.production-entry-v1 {
    margin-top:14px;

    padding:15px;

    border:1px solid #dbe4ef;
    border-radius:11px;

    background:#ffffff;
}


.production-head-v1 {
    display:flex;

    justify-content:space-between;
    align-items:center;

    gap:10px;

    margin-bottom:13px;
}


.production-head-v1 strong {
    font-size:13px;
    color:#172235;
}


.production-head-v1 span {
    padding:4px 8px;

    border-radius:999px;

    background:#eaf1fb;
    color:#173d68;

    font-size:9px;
    font-weight:900;
}


.production-grid-v1 {
    display:grid;

    grid-template-columns:
        repeat(3,minmax(0,1fr));

    gap:10px;
}


.production-field-v1 label {
    display:block;

    margin-bottom:5px;

    color:#64748b;

    font-size:9px;
    font-weight:900;

    text-transform:uppercase;
}


.production-field-v1 input {
    width:100%;

    min-height:39px;

    border:1px solid #cbd5e1;
    border-radius:8px;

    padding:8px 10px;

    color:#172235;
    font-weight:800;
}


.production-time-pair-v1 {
    display:grid;

    grid-template-columns:
        1fr 1fr;

    gap:6px;
}


.production-save-row-v1 {
    display:flex;

    align-items:center;
    justify-content:flex-end;

    gap:10px;

    margin-top:13px;
}


.production-save-btn-v1 {
    border:0;

    border-radius:9px;

    background:#173d68;

    color:#fff;

    padding:10px 15px;

    font-weight:900;

    cursor:pointer;
}


.production-feedback-v1 {
    margin-right:auto;

    color:#15803d;

    font-size:11px;
    font-weight:800;
}


@media(max-width:650px) {

    .production-grid-v1 {
        grid-template-columns:1fr;
    }
}




/* MACHINE_OEE_LOSS_ENTRY_V1_CSS */

.machine-loss-entry-v1 {
    margin-top:14px;

    padding:15px;

    border:1px solid #dbe4ef;
    border-radius:11px;

    background:#ffffff;
}


.machine-loss-head-v1 {
    display:flex;

    justify-content:space-between;
    align-items:center;

    gap:10px;

    margin-bottom:12px;
}


.machine-loss-head-v1 strong {
    color:#172235;

    font-size:13px;
}


.machine-loss-head-v1 span {
    padding:4px 8px;

    border-radius:999px;

    background:#eef4ff;

    color:#2563eb;

    font-size:9px;
    font-weight:900;
}


.machine-loss-form-v1 {
    display:grid;

    grid-template-columns:
        minmax(0,1fr)
        120px
        auto;

    gap:8px;

    align-items:end;
}


.machine-loss-field-v1 label {
    display:block;

    margin-bottom:5px;

    color:#64748b;

    font-size:9px;
    font-weight:900;

    text-transform:uppercase;
}


.machine-loss-field-v1 select,
.machine-loss-field-v1 input {
    width:100%;

    min-height:39px;

    padding:8px 10px;

    border:1px solid #cbd5e1;

    border-radius:8px;

    background:#fff;

    color:#172235;

    font-weight:700;
}


.machine-loss-add-v1 {
    min-height:39px;

    padding:8px 13px;

    border:0;

    border-radius:8px;

    background:#173d68;

    color:#fff;

    font-weight:900;

    cursor:pointer;

    white-space:nowrap;
}


.machine-loss-list-v1 {
    display:flex;

    flex-direction:column;

    gap:6px;

    margin-top:11px;
}


.machine-loss-row-v1 {
    display:grid;

    grid-template-columns:
        52px
        minmax(0,1fr)
        85px
        30px;

    gap:8px;

    align-items:center;

    padding:8px 9px;

    border:1px solid #e2e8f0;

    border-radius:8px;

    background:#f8fafc;

    font-size:11px;
}


.machine-loss-code-v1 {
    color:#173d68;

    font-weight:900;
}


.machine-loss-min-v1 {
    text-align:right;

    color:#172235;

    font-weight:900;
}


.machine-loss-remove-v1 {
    width:28px;
    height:28px;

    border:0;

    border-radius:7px;

    background:#e2e8f0;

    color:#64748b;

    font-weight:900;

    cursor:pointer;
}


.machine-loss-empty-v1 {
    padding:8px 2px;

    color:#94a3b8;

    font-size:11px;
}


.machine-loss-feedback-v1 {
    min-height:17px;

    margin-top:7px;

    color:#15803d;

    font-size:10px;

    font-weight:800;
}


@media(max-width:620px) {

    .machine-loss-form-v1 {
        grid-template-columns:1fr;
    }
}




/* MACHINE_OEE_LIVE_PANEL_V1_CSS */

.machine-live-oee-v1 {
    margin-top:14px;

    background:#fff;

    border:1px solid #dfe5ed;

    border-radius:14px;

    padding:16px;
}


.machine-live-head-v1 {
    display:flex;

    align-items:center;
    justify-content:space-between;

    gap:8px;

    margin-bottom:12px;
}


.machine-live-head-v1 strong {
    font-size:14px;

    color:#172235;
}


.machine-live-profile-v1 {
    padding:4px 8px;

    border-radius:999px;

    background:#eef4ff;

    color:#2563eb;

    font-size:9px;
    font-weight:900;
}


.machine-oee-hero-v1 {
    padding:15px;

    border-radius:12px;

    background:#173d68;

    color:#fff;

    margin-bottom:10px;
}


.machine-oee-hero-v1 span {
    display:block;

    font-size:10px;

    opacity:.75;
}


.machine-oee-hero-v1 strong {
    display:block;

    margin-top:4px;

    font-size:38px;

    line-height:1;
}


.machine-oee-kpis-v1 {
    display:grid;

    grid-template-columns:
        repeat(3,1fr);

    gap:6px;

    margin-bottom:11px;
}


.machine-oee-kpi-v1 {
    padding:9px 5px;

    background:#f6f8fb;

    border-radius:8px;

    text-align:center;
}


.machine-oee-kpi-v1 strong {
    display:block;

    color:#172235;

    font-size:16px;
}


.machine-oee-kpi-v1 span {
    display:block;

    margin-top:2px;

    color:#64748b;

    font-size:9px;

    font-weight:900;
}


.machine-oee-metric-v1 {
    display:flex;

    justify-content:space-between;

    gap:10px;

    padding:7px 1px;

    border-bottom:1px solid #edf1f5;

    font-size:11px;
}


.machine-oee-metric-v1:last-child {
    border-bottom:0;
}


.machine-oee-metric-v1 span {
    color:#64748b;
}


.machine-oee-metric-v1 strong {
    color:#172235;

    text-align:right;
}


.machine-live-note-v1 {
    padding:12px;

    background:#f8fafc;

    border-radius:8px;

    color:#64748b;

    font-size:10px;

    line-height:1.45;
}




/* ACTUAL_OPERATOR_SELECTION_V1_CSS */

.actual-operator-box-v1 {
    display:flex;

    align-items:center;
    justify-content:space-between;

    gap:14px;

    margin-bottom:14px;

    padding:12px 14px;

    border:1px solid #bfdbfe;
    border-radius:11px;

    background:#eff6ff;
}


.actual-operator-label-v1 strong {
    display:block;

    color:#1e3a8a;

    font-size:12px;
}


.actual-operator-label-v1 small {
    display:block;

    margin-top:3px;

    color:#64748b;

    font-size:10px;
}


.actual-operator-select-v1 {
    min-width:260px;
    max-width:400px;

    min-height:40px;

    border:1px solid #93c5fd;
    border-radius:8px;

    padding:8px 10px;

    background:#fff;

    color:#172235;

    font-weight:800;
}


@media(max-width:650px) {

    .actual-operator-box-v1 {
        flex-direction:column;
        align-items:stretch;
    }


    .actual-operator-select-v1 {
        width:100%;
        min-width:0;
        max-width:none;
    }
}




/* MACHINE_OEE_SIMPLE_OPERATOR_FLOW_V1 */

.machine-oee-smart-action-v1 {
    margin-top: 12px;
    padding: 12px;

    border: 1px solid #cbd5e1;
    border-radius: 10px;

    background: #f8fafc;
}


.machine-oee-smart-action-label-v1 {
    margin-bottom: 7px;

    color: #64748b;

    font-size: 10px;
    font-weight: 900;

    text-transform: uppercase;
    letter-spacing: .04em;
}


.machine-oee-smart-action-btn-v1 {
    width: 100%;
    min-height: 46px;

    border: 0;
    border-radius: 9px;

    padding: 10px 16px;

    background: #0b5fa5;

    color: #fff;

    font-size: 14px;
    font-weight: 900;

    cursor: pointer;
}


.machine-oee-smart-action-btn-v1.receive {
    background: #15803d;
}


.machine-oee-smart-action-btn-v1:disabled {
    background: #94a3b8;

    cursor: not-allowed;

    opacity: .8;
}


.machine-oee-smart-action-help-v1 {
    margin-top: 6px;

    color: #64748b;

    font-size: 10px;
}




/* =========================================================
   MACHINE_OEE_EXISTING_JMS_THEME_V1

   IMPORTANT:
   OEE must visually belong to the existing JMS.
   Reuse existing JMS typography, tokens, density and shapes.
   ========================================================= */


/* ---------------------------------------------------------
   OEE PAGE TYPOGRAPHY
   --------------------------------------------------------- */

.machine-live-header-v1,
.machine-live-header-v1 *,
.machine-oee-smart-action-v1,
.machine-oee-smart-action-v1 *,
.actual-operator-box-v1,
.actual-operator-box-v1 * {
    font-family:
        "IBM Plex Sans",
        sans-serif !important;
}


/* ---------------------------------------------------------
   MACHINE HEADER

   Same visual family as common JMS page headers:
   soft blue background,
   compact radius,
   blue left accent.
   --------------------------------------------------------- */

.machine-live-header-v1 {
    position: relative;

    margin-bottom: 20px;

    padding: 16px 18px;

    border:
        1px solid
        var(--border, #d0d7e2);

    border-left:
        4px solid
        #0b5fa5;

    border-radius: 8px;

    background:
        linear-gradient(
            135deg,
            #f7fcff 0%,
            #e5f4ff 100%
        );

    box-shadow:
        0 2px 7px
        rgba(15, 42, 77, .08);

    color:
        var(--text, #172235);
}


/*
 * Remove the extra decorative side element
 * from the first version.
 */
.machine-live-header-v1::before {
    display: none !important;
}


/* ---------------------------------------------------------
   MACHINE IDENTITY
   --------------------------------------------------------- */

.machine-live-eyebrow-v1 {
    margin-bottom: 3px;

    color:
        var(--muted, #6b7280);

    font-size: 11px;

    font-weight: 600;

    letter-spacing: .3px;

    text-transform: uppercase;
}


.machine-live-machine-no-v1 {
    margin: 0;

    color:
        var(--text, #0f2a4d);

    font-size: 24px;

    font-weight: 700;

    line-height: 1.2;

    letter-spacing: 0;
}


.machine-live-machine-name-v1 {
    margin-top: 3px;

    color:
        var(--muted, #6b7280);

    font-size: 13px;

    font-weight: 500;
}


/* ---------------------------------------------------------
   READY / RUNNING STATUS
   --------------------------------------------------------- */

.machine-live-status-v1 {
    display: inline-flex;

    align-items: center;

    gap: 6px;

    min-height: 28px;

    padding: 4px 10px;

    border:
        1px solid
        #86efac;

    border-radius: 20px;

    background: #f0fdf4;

    color: #16a34a;

    font-size: 11px;

    font-weight: 700;

    letter-spacing: 0;
}


.machine-live-status-v1.running {
    border-color: #86efac;

    background: #f0fdf4;

    color: #16a34a;

    box-shadow: none;
}


.machine-live-status-dot-v1 {
    width: 7px;
    height: 7px;

    border-radius: 50%;

    background: currentColor;
}


/*
 * Keep only a very subtle pulse.
 * The page should not feel like a different application.
 */
.machine-live-status-v1.running
.machine-live-status-dot-v1 {
    animation:
        machineJmsPulseV1
        2s
        infinite;
}


@keyframes machineJmsPulseV1 {

    0%,
    100% {
        opacity: 1;
    }

    50% {
        opacity: .45;
    }
}


/* ---------------------------------------------------------
   CONTEXT CHIPS
   --------------------------------------------------------- */

.machine-live-meta-v1 {
    display: flex;

    flex-wrap: wrap;

    gap: 7px;

    margin-top: 12px;
}


.machine-live-chip-v1 {
    display: inline-flex;

    align-items: center;

    gap: 5px;

    min-height: 26px;

    padding: 4px 9px;

    border:
        1px solid
        var(--border, #d0d7e2);

    border-radius: 6px;

    background:
        var(--surface, #ffffff);

    color:
        var(--muted, #6b7280);

    font-size: 11px;

    font-weight: 500;
}


.machine-live-chip-v1 strong {
    color:
        var(--text, #0f2a4d);

    font-weight: 700;
}


/* ---------------------------------------------------------
   OPERATOR / SHIFT AREA
   --------------------------------------------------------- */

.machine-live-controls-v1 {
    display: grid;

    grid-template-columns:
        minmax(0, 1.4fr)
        minmax(180px, .6fr);

    gap: 12px;

    margin-top: 13px;

    padding-top: 13px;

    border-top:
        1px solid
        var(--border, #d0d7e2);
}


.machine-live-control-v1 label {
    display: block;

    margin: 0 0 5px;

    color: #374151;

    font-size: 11px;

    font-weight: 700;

    letter-spacing: .3px;

    text-transform: uppercase;
}


/* ---------------------------------------------------------
   EXISTING JMS FORM CONTROL LOOK
   --------------------------------------------------------- */

.machine-live-control-slot-v1 select {
    width: 100% !important;

    min-height: 38px !important;

    margin: 0 !important;

    padding:
        8px 11px !important;

    border:
        1px solid
        var(--border, #d0d7e2) !important;

    border-radius:
        6px !important;

    background:
        var(--surface, #ffffff) !important;

    color:
        var(--text, #0f2a4d) !important;

    font-family:
        "IBM Plex Sans",
        sans-serif !important;

    font-size:
        13px !important;

    font-weight:
        500 !important;

    outline:
        none !important;

    box-shadow:
        none !important;
}


.machine-live-control-slot-v1 select:focus {
    border-color:
        var(--accent, #2f6397) !important;

    box-shadow:
        0 0 0 2px
        rgba(47, 99, 151, .12) !important;
}


/* ---------------------------------------------------------
   SMART JC ACTION

   Same button language as existing JMS.
   --------------------------------------------------------- */

.machine-oee-smart-action-v1 {
    border:
        1px solid
        var(--border, #d0d7e2);

    border-radius: 8px;

    background:
        var(--surface, #ffffff);

    padding: 12px;

    box-shadow: none;
}


.machine-oee-smart-action-label-v1 {
    color: #374151;

    font-size: 11px;

    font-weight: 700;

    letter-spacing: .3px;

    text-transform: uppercase;
}


.machine-oee-smart-action-btn-v1 {
    min-height: 40px;

    border-radius: 6px;

    background:
        var(--accent, #2f6397);

    font-family:
        "IBM Plex Sans",
        sans-serif;

    font-size: 13px;

    font-weight: 700;
}


.machine-oee-smart-action-btn-v1.receive {
    background: #16a34a;
}


/* ---------------------------------------------------------
   EXISTING ACTUAL OPERATOR BOX
   --------------------------------------------------------- */

.actual-operator-box-v1 {
    border:
        1px solid
        var(--border, #d0d7e2);

    border-radius: 6px;

    background:
        var(--surface2, #f8fafc);

    box-shadow: none;
}


.actual-operator-label-v1 strong {
    color:
        var(--text, #0f2a4d);

    font-size: 12px;

    font-weight: 700;
}


.actual-operator-label-v1 small {
    color:
        var(--muted, #6b7280);

    font-size: 11px;
}


/* ---------------------------------------------------------
   RESPONSIVE
   --------------------------------------------------------- */

@media (max-width: 680px) {

    .machine-live-header-v1 {
        padding: 14px;
    }


    .machine-live-controls-v1 {
        grid-template-columns:
            1fr;
    }


    .machine-live-machine-no-v1 {
        font-size: 22px;
    }
}




/* =========================================================
   MACHINE_OEE_JOBCARD_NATIVE_V1
   Existing JMS visual language.
   ========================================================= */


/* ---------------------------------------------------------
   JOB CARD MAIN CARD
   --------------------------------------------------------- */

.machine-oee-jc-native-v1 {
    position: relative;

    border:
        1px solid
        var(--border, #d0d7e2) !important;

    border-radius: 8px !important;

    background:
        var(--surface, #ffffff) !important;

    box-shadow:
        0 2px 7px
        rgba(15, 42, 77, .06) !important;

    font-family: inherit !important;
}


/* ---------------------------------------------------------
   SECTION HEADER
   --------------------------------------------------------- */

.machine-oee-jc-section-head-v1 {
    display: flex;

    align-items: center;

    gap: 10px;

    margin-bottom: 14px;
}


.machine-oee-jc-section-icon-v1 {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    width: 34px;
    height: 34px;

    flex: none;

    border-radius: 7px;

    background: #edf6ff;

    color:
        var(--accent, #2f6397);

    font-size: 15px;
}


.machine-oee-jc-section-title-v1 {
    min-width: 0;
}


.machine-oee-jc-section-title-v1 strong {
    display: block;

    color:
        var(--text, #0f2a4d);

    font-size: 16px;

    font-weight: 700;

    line-height: 1.2;
}


.machine-oee-jc-section-title-v1 small {
    display: block;

    margin-top: 2px;

    color:
        var(--muted, #6b7280);

    font-size: 11px;

    font-weight: 400;
}


/* ---------------------------------------------------------
   JC INPUT
   --------------------------------------------------------- */

.machine-oee-jc-native-v1
input[data-machine-oee-jc-input-v1="1"] {
    min-height: 44px !important;

    border:
        1px solid
        var(--border, #d0d7e2) !important;

    border-radius: 6px !important;

    background: #ffffff !important;

    color:
        var(--text, #0f2a4d) !important;

    font-family: inherit !important;

    font-size: 15px !important;

    font-weight: 600 !important;

    letter-spacing: .2px;
}


.machine-oee-jc-native-v1
input[data-machine-oee-jc-input-v1="1"]:focus {
    outline: none !important;

    border-color:
        var(--accent, #2f6397) !important;

    box-shadow:
        0 0 0 2px
        rgba(47, 99, 151, .12) !important;
}


/* ---------------------------------------------------------
   FETCH BUTTON
   --------------------------------------------------------- */

.machine-oee-jc-fetch-v1 {
    display: inline-flex !important;

    align-items: center !important;
    justify-content: center !important;

    gap: 7px !important;

    min-height: 42px !important;

    border-radius: 6px !important;

    font-family: inherit !important;

    font-weight: 700 !important;
}


/* ---------------------------------------------------------
   FETCHED RESULT
   --------------------------------------------------------- */

.machine-oee-jc-result-v1 {
    margin-top: 14px !important;

    padding: 14px !important;

    border:
        1px solid
        #cfe2d5 !important;

    border-radius: 8px !important;

    background:
        #f8fcf9 !important;

    box-shadow: none !important;
}


.machine-oee-jc-result-v1
[data-machine-oee-jc-info-v1="1"] {
    position: relative;

    min-height: 74px;

    padding: 11px 12px !important;

    border:
        1px solid
        var(--border, #dbe3ec) !important;

    border-radius: 6px !important;

    background:
        #ffffff !important;

    box-shadow: none !important;
}


.machine-oee-jc-result-v1
[data-machine-oee-jc-info-v1="1"]
.machine-oee-jc-info-primary-v1 {
    border-left:
        3px solid
        var(--accent, #2f6397) !important;
}


/* ---------------------------------------------------------
   INFO LABEL
   --------------------------------------------------------- */

.machine-oee-jc-info-label-v1 {
    display: flex !important;

    align-items: center !important;

    gap: 6px !important;

    margin-bottom: 5px !important;

    color:
        var(--muted, #6b7280) !important;

    font-size: 10px !important;

    font-weight: 700 !important;

    letter-spacing: .25px !important;

    text-transform: uppercase !important;
}


.machine-oee-jc-info-label-v1 i {
    color:
        var(--accent, #2f6397);

    font-size: 10px;
}


/* ---------------------------------------------------------
   MAIN DATA VALUE
   --------------------------------------------------------- */

.machine-oee-jc-result-v1
[data-machine-oee-jc-info-v1="1"]
strong,
.machine-oee-jc-result-v1
[data-machine-oee-jc-info-v1="1"]
.machine-oee-jc-value-v1 {
    color:
        var(--text, #0f2a4d) !important;

    font-size: 13px !important;

    font-weight: 600 !important;

    line-height: 1.35 !important;
}


.machine-oee-jc-result-v1
.machine-oee-jc-info-primary-v1
strong {
    font-size: 15px !important;

    font-weight: 700 !important;
}


/* ---------------------------------------------------------
   READY STATUS
   --------------------------------------------------------- */

.machine-oee-ready-fa-v1 {
    display: inline-flex !important;

    align-items: center !important;
    justify-content: center !important;

    gap: 7px !important;

    cursor: pointer !important;
}


.machine-oee-ready-fa-v1 i {
    color: inherit;
}


/* ---------------------------------------------------------
   SMART ACTION
   --------------------------------------------------------- */

#machine-oee-smart-action-btn-v1 {
    display: inline-flex !important;

    align-items: center !important;
    justify-content: center !important;

    gap: 7px !important;
}


/* ---------------------------------------------------------
   MOBILE
   --------------------------------------------------------- */

@media (max-width: 680px) {

    .machine-oee-jc-section-head-v1 {
        align-items: flex-start;
    }


    .machine-oee-jc-result-v1
    [data-machine-oee-jc-info-v1="1"] {
        min-height: 0;
    }
}






/* =========================================================
   MACHINE_OEE_DIRECT_ENTRY_V3
   Direct operator-entry layout based on the original
   OEE completion modal.
   ========================================================= */

#machine-oee-direct-entry-v3 {
    margin-top: 14px;

    border:
        1px solid
        var(--border, #d0d7e2);

    border-radius: 8px;

    background:
        var(--surface, #ffffff);

    box-shadow:
        0 2px 7px
        rgba(15, 42, 77, .05);

    overflow: hidden;

    font-family: inherit;
}


/* ---------------------------------------------------------
   HEADER
   --------------------------------------------------------- */

.oee-direct-head-v3 {
    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 12px;

    padding: 11px 14px;

    border-bottom:
        1px solid
        var(--border, #d0d7e2);

    background:
        #f7f9fc;
}


.oee-direct-title-v3 {
    display: flex;

    align-items: center;

    gap: 8px;
}


.oee-direct-title-icon-v3 {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    width: 29px;
    height: 29px;

    border-radius: 6px;

    background: #eaf3fb;

    color:
        var(--accent, #2f6397);
}


.oee-direct-title-v3 strong {
    display: block;

    color:
        var(--text, #0f2a4d);

    font-size: 15px;

    font-weight: 700;
}


.oee-direct-title-v3 small {
    display: block;

    margin-top: 1px;

    color:
        var(--muted, #6b7280);

    font-size: 10px;
}


.oee-direct-run-status-v3 {
    display: inline-flex;

    align-items: center;

    gap: 5px;

    padding: 4px 8px;

    border-radius: 5px;

    background: #edf8f0;

    color: #16833a;

    font-size: 10px;

    font-weight: 700;
}


/* ---------------------------------------------------------
   BODY
   --------------------------------------------------------- */

.oee-direct-body-v3 {
    padding: 13px 14px 14px;
}


/* ---------------------------------------------------------
   SECTION HEADERS
   --------------------------------------------------------- */

.oee-direct-section-v3
+ .oee-direct-section-v3 {
    margin-top: 15px;

    padding-top: 14px;

    border-top:
        1px solid
        var(--border, #e0e6ed);
}


.oee-direct-section-head-v3 {
    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 10px;

    margin-bottom: 10px;
}


.oee-direct-section-title-v3 {
    display: inline-flex;

    align-items: center;

    gap: 6px;

    color:
        var(--text, #0f2a4d);

    font-size: 12px;

    font-weight: 700;
}


.oee-direct-section-title-v3 i {
    color:
        var(--accent, #2f6397);
}


.oee-direct-section-note-v3 {
    color:
        var(--muted, #6b7280);

    font-size: 10px;
}


/* ---------------------------------------------------------
   PRODUCTION GRID
   --------------------------------------------------------- */

.oee-direct-production-grid-v3 {
    display: grid;

    grid-template-columns:
        repeat(3, minmax(0, 1fr));

    gap: 10px 12px;
}


.oee-direct-field-v3 {
    min-width: 0;
}


.oee-direct-field-v3.wide {
    grid-column: span 2;
}


.oee-direct-field-v3 label {
    display: flex;

    align-items: center;

    gap: 5px;

    margin-bottom: 4px;

    color: #516174;

    font-size: 9px;

    font-weight: 700;

    letter-spacing: .2px;

    text-transform: uppercase;
}


.oee-direct-field-v3 label i {
    color:
        var(--accent, #2f6397);

    font-size: 10px;
}


.oee-direct-field-v3 input,
.oee-direct-field-v3 select,
.oee-direct-field-v3 textarea {
    width: 100%;

    min-height: 36px;

    border:
        1px solid
        var(--border, #d0d7e2);

    border-radius: 6px;

    padding: 7px 9px;

    background: #ffffff;

    color:
        var(--text, #0f2a4d);

    font-family: inherit;

    font-size: 12px;

    font-weight: 500;

    box-shadow: none;
}


.oee-direct-field-v3 input:focus,
.oee-direct-field-v3 select:focus,
.oee-direct-field-v3 textarea:focus {
    outline: none;

    border-color:
        var(--accent, #2f6397);

    box-shadow:
        0 0 0 2px
        rgba(47, 99, 151, .10);
}


.oee-direct-field-v3 input[readonly] {
    background: #f7f9fb;

    color:
        var(--muted, #6b7280);
}


/* ---------------------------------------------------------
   MIN / SEC PAIR
   --------------------------------------------------------- */

.oee-direct-time-pair-v3 {
    display: grid;

    grid-template-columns:
        1fr 1fr;

    gap: 6px;
}


.oee-direct-time-input-v3 {
    position: relative;
}


.oee-direct-time-input-v3 span {
    position: absolute;

    right: 8px;
    top: 50%;

    transform:
        translateY(-50%);

    color:
        var(--muted, #6b7280);

    font-size: 9px;

    pointer-events: none;
}


.oee-direct-time-input-v3 input {
    padding-right: 30px;
}


/* ---------------------------------------------------------
   LOSS GRID
   Old modal style:
   A1-A27 always visible as direct minute entry.
   --------------------------------------------------------- */

.oee-direct-loss-tools-v3 {
    display: flex;

    align-items: center;
    justify-content: flex-end;

    margin-bottom: 8px;
}


.oee-direct-loss-toggle-v3 {
    display: inline-flex;

    align-items: center;

    gap: 5px;

    border: 0;

    background: transparent;

    color:
        var(--accent, #2f6397);

    font-family: inherit;

    font-size: 10px;

    font-weight: 700;

    cursor: pointer;
}


#oee-direct-loss-grid-v3 {
    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 7px 10px;
}


#oee-direct-loss-grid-v3.collapsed {
    display: none;
}


.oee-direct-loss-row-v3 {
    display: grid;

    grid-template-columns:
        minmax(0, 1fr)
        86px;

    align-items: center;

    gap: 8px;

    min-height: 39px;

    padding: 6px 7px 6px 9px;

    border:
        1px solid
        var(--border, #dbe3ec);

    border-radius: 6px;

    background: #ffffff;
}


.oee-direct-loss-info-v3 {
    min-width: 0;
}


.oee-direct-loss-code-v3 {
    display: inline-block;

    min-width: 26px;

    margin-right: 5px;

    color:
        var(--accent, #2f6397);

    font-size: 10px;

    font-weight: 700;
}


.oee-direct-loss-name-v3 {
    color:
        var(--text, #0f2a4d);

    font-size: 10px;

    font-weight: 500;
}


.oee-direct-loss-input-wrap-v3 {
    position: relative;
}


.oee-direct-loss-input-v3 {
    width: 100%;

    min-height: 30px;

    border:
        1px solid
        var(--border, #d0d7e2);

    border-radius: 5px;

    padding:
        5px 27px 5px 7px;

    background: #ffffff;

    color:
        var(--text, #0f2a4d);

    font-family: inherit;

    font-size: 11px;

    text-align: right;
}


.oee-direct-loss-input-v3:focus {
    outline: none;

    border-color:
        var(--accent, #2f6397);

    box-shadow:
        0 0 0 2px
        rgba(47, 99, 151, .08);
}


.oee-direct-loss-unit-v3 {
    position: absolute;

    right: 6px;
    top: 50%;

    transform:
        translateY(-50%);

    color:
        var(--muted, #6b7280);

    font-size: 8px;

    pointer-events: none;
}


/* ---------------------------------------------------------
   COMPLETION FIELDS
   --------------------------------------------------------- */

.oee-direct-completion-grid-v3 {
    display: grid;

    grid-template-columns:
        1fr 1fr;

    gap: 10px;
}


/* ---------------------------------------------------------
   FOOTER ACTIONS
   --------------------------------------------------------- */

.oee-direct-actions-v3 {
    display: flex;

    align-items: center;
    justify-content: flex-end;

    gap: 9px;

    margin-top: 13px;

    padding-top: 12px;

    border-top:
        1px solid
        var(--border, #e0e6ed);
}


.oee-direct-feedback-v3 {
    margin-right: auto;

    color:
        var(--muted, #6b7280);

    font-size: 10px;

    font-weight: 500;
}


.oee-direct-button-v3 {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    gap: 6px;

    min-height: 38px;

    border: 0;

    border-radius: 6px;

    padding: 8px 14px;

    font-family: inherit;

    font-size: 11px;

    font-weight: 700;

    cursor: pointer;
}


.oee-direct-save-v3 {
    background:
        var(--accent, #2f6397);

    color: #ffffff;
}


.oee-direct-complete-v3 {
    min-width: 190px;

    background: #16833a;

    color: #ffffff;
}


.oee-direct-button-v3:disabled {
    cursor: not-allowed;

    opacity: .55;
}


/* ---------------------------------------------------------
   OLD UI IS NOT PART OF THE NEW OPERATOR WORKSPACE
   --------------------------------------------------------- */

.oee-direct-hidden-old-v3 {
    display: none !important;
}


/* ---------------------------------------------------------
   MOBILE
   --------------------------------------------------------- */

@media (max-width: 760px) {

    .oee-direct-production-grid-v3 {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }


    #oee-direct-loss-grid-v3 {
        grid-template-columns: 1fr;
    }
}


@media (max-width: 520px) {

    .oee-direct-production-grid-v3,
    .oee-direct-completion-grid-v3 {
        grid-template-columns: 1fr;
    }


    .oee-direct-field-v3.wide {
        grid-column: span 1;
    }


    .oee-direct-actions-v3 {
        align-items: stretch;

        flex-direction: column;
    }


    .oee-direct-feedback-v3 {
        margin-right: 0;
    }


    .oee-direct-button-v3 {
        width: 100%;
    }
}






/* MACHINE_OEE_JMS_FONT_V6 */

html,
body,
button,
input,
select,
textarea {
    font-family:
        "IBM Plex Sans",
        sans-serif !important;
}


#machine-oee-direct-entry-v3 {
    font-family:
        "IBM Plex Sans",
        sans-serif !important;
}


#machine-oee-direct-entry-v3
.oee-direct-field-v3 input,
#machine-oee-direct-entry-v3
.oee-direct-field-v3 select,
#machine-oee-direct-entry-v3
.oee-direct-field-v3 textarea {
    border-radius: 4px;
}


#machine-oee-direct-entry-v3
.oee-direct-button-v3 {
    border-radius: 4px;
}




/* MACHINE_OEE_RUNTIME_REPAIR_V7_CSS */

.back-link,
.machine-chip,
.jc-ready-btn-v1,
.machine-live-profile-v1 {
    display: inline-flex;
    align-items: center;
    gap: 6px;
}


.back-link i,
.machine-chip i {
    flex: none;
}


body,
button,
input,
select,
textarea {
    font-family:
        "IBM Plex Sans",
        sans-serif !important;
}




/* =========================================================
   MACHINE_OEE_QTY_COUNTERS_V8
   ========================================================= */

.oee-qty-field-v8 label {
    margin-bottom: 5px !important;
}


.oee-qty-counter-v8 {
    display: grid;

    grid-template-columns:
        42px
        minmax(0, 1fr)
        42px;

    min-height: 40px;

    overflow: hidden;

    border: 1px solid #cbd5e1;

    border-radius: 6px;

    background: #ffffff;
}


.oee-qty-counter-v8.ok {
    border-color: #86efac;

    background: #f0fdf4;
}


.oee-qty-counter-v8.reject {
    border-color: #fecaca;

    background: #fef2f2;
}


.oee-qty-counter-v8.hold {
    border-color: #fde68a;

    background: #fffbeb;
}


.oee-qty-btn-v8 {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    width: 100%;
    min-height: 40px;

    margin: 0;
    padding: 0;

    border: 0;

    background: rgba(255, 255, 255, .65);

    color: #172235;

    font-family: inherit;

    font-size: 12px;

    cursor: pointer;
}


.oee-qty-btn-v8:first-child {
    border-right: 1px solid rgba(148, 163, 184, .35);
}


.oee-qty-btn-v8:last-child {
    border-left: 1px solid rgba(148, 163, 184, .35);
}


.oee-qty-btn-v8:hover:not(:disabled) {
    background: #ffffff;
}


.oee-qty-btn-v8:disabled {
    cursor: not-allowed;

    opacity: .35;
}


.oee-qty-input-slot-v8 {
    min-width: 0;
}


.oee-qty-input-slot-v8 input {
    width: 100% !important;
    height: 100% !important;
    min-height: 40px !important;

    margin: 0 !important;
    padding: 6px !important;

    border: 0 !important;
    border-radius: 0 !important;

    background: transparent !important;

    color: #172235 !important;

    font-family: inherit !important;

    font-size: 16px !important;
    font-weight: 700 !important;

    text-align: center !important;

    box-shadow: none !important;

    appearance: textfield;
    -moz-appearance: textfield;
}


.oee-qty-input-slot-v8 input:focus {
    outline: none !important;

    box-shadow: none !important;
}


.oee-qty-input-slot-v8
input::-webkit-inner-spin-button,
.oee-qty-input-slot-v8
input::-webkit-outer-spin-button {
    margin: 0;

    -webkit-appearance: none;
}


.oee-qty-summary-v8 {
    grid-column: 1 / -1;

    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 12px;

    margin-top: 1px;

    padding: 8px 10px;

    border: 1px solid #e2e8f0;

    border-radius: 6px;

    background: #f8fafc;
}


.oee-qty-summary-item-v8 {
    display: inline-flex;

    align-items: center;

    gap: 6px;

    color: #64748b;

    font-size: 10px;

    font-weight: 500;
}


.oee-qty-summary-item-v8 i {
    color: #2f6397;
}


.oee-qty-summary-item-v8 strong {
    color: #172235;

    font-size: 12px;

    font-weight: 700;
}


.oee-qty-summary-item-v8.pending {
    color: #9a6700;
}


.oee-qty-summary-item-v8.pending i,
.oee-qty-summary-item-v8.pending strong {
    color: #b7791f;
}


.oee-qty-summary-item-v8.pending.complete {
    color: #15803d;
}


.oee-qty-summary-item-v8.pending.complete i,
.oee-qty-summary-item-v8.pending.complete strong {
    color: #15803d;
}


@media(max-width:620px) {

    .oee-qty-summary-v8 {
        align-items: flex-start;

        flex-direction: column;
    }
}




/* =========================================================
   MACHINE_OEE_REASON_AND_ACTIVE_LOCK_V9
   ========================================================= */

.oee-direct-qty-reasons-v9 {
    display:none;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap:10px;

    margin-top:8px;
}


.oee-direct-qty-reasons-v9.one {
    grid-template-columns:1fr;
}


.oee-direct-reason-field-v9 {
    min-width:0;
}


.oee-direct-reason-field-v9 label {
    display:block;

    margin-bottom:5px;

    color:#475569;

    font-size:9px;

    font-weight:800;

    text-transform:uppercase;

    letter-spacing:.025em;
}


.oee-direct-reason-field-v9 label i {
    margin-right:4px;
}


.oee-reason-select-v9,
.oee-reason-other-v9 {
    width:100%;

    min-height:38px;

    padding:7px 9px;

    border:1px solid #cbd5e1;

    border-radius:6px;

    background:#ffffff;

    color:#172235;

    font-family:inherit;

    font-size:11px;

    font-weight:600;

    outline:none;
}


#oee-direct-rejection-field-v9
.oee-reason-select-v9,
#oee-direct-rejection-field-v9
.oee-reason-other-v9 {
    border-color:#fca5a5;

    background:#fffafa;
}


#oee-direct-hold-field-v9
.oee-reason-select-v9,
#oee-direct-hold-field-v9
.oee-reason-other-v9 {
    border-color:#fbbf24;

    background:#fffdf5;
}


.oee-reason-select-v9:focus,
.oee-reason-other-v9:focus {
    border-color:#2563eb;

    box-shadow:
        0 0 0 2px
        rgba(37, 99, 235, .08);
}


.oee-reason-other-v9 {
    display:none;

    margin-top:6px;
}


.machine-active-lock-v9 {
    border-color:#fdba74 !important;

    background:#fff7ed !important;
}


.machine-active-lock-v9 h3 {
    display:flex;

    align-items:center;

    gap:6px;

    color:#9a3412 !important;
}


.machine-active-lock-note-v9 {
    margin-top:10px;

    padding:8px 10px;

    border:1px solid #fed7aa;

    border-radius:7px;

    background:#ffffff;

    color:#9a3412;

    font-size:10px;

    font-weight:700;
}


@media(max-width:650px) {

    .oee-direct-qty-reasons-v9 {
        grid-template-columns:1fr;
    }
}




/* =========================================================
   MACHINE_OEE_AUTO_OK_REASON_ROWS_V10
   ========================================================= */


/* Old Available / Pending strip is gone. */
.oee-qty-summary-v8 {
    display:none !important;
}


/*
 * Dynamic reason container occupies the full
 * Production & Time width.
 */
#oee-direct-qty-reasons-v9 {
    grid-column:1 / -1;

    display:none;

    grid-template-columns:1fr !important;

    gap:9px;

    width:100%;

    margin-top:3px;
}


/* One reason per complete row. */
#oee-direct-qty-reasons-v9
.oee-direct-reason-field-v9 {
    display:block;

    grid-column:1 / -1;

    width:100%;

    max-width:none;
}


#oee-direct-qty-reasons-v9
.oee-direct-reason-field-v9 label {
    display:flex;

    align-items:center;

    gap:5px;

    margin-bottom:5px;
}


#oee-direct-qty-reasons-v9
.oee-reason-select-v9,
#oee-direct-qty-reasons-v9
.oee-reason-other-v9 {
    width:100% !important;

    max-width:none !important;

    min-height:39px;
}


/* Three production outcomes remain one row. */
.oee-direct-production-grid-v3 {
    grid-template-columns:
        repeat(
            3,
            minmax(0,1fr)
        );
}


.oee-qty-input-slot-v8 input {
    font-size:17px !important;

    font-weight:700 !important;
}


@media(max-width:650px) {

    .oee-direct-production-grid-v3 {
        grid-template-columns:1fr;
    }


    #oee-direct-qty-reasons-v9 {
        grid-column:1;
    }
}




/* =========================================================
   MACHINE_OEE_SHIFT_TIMING_V11
   ========================================================= */

.machine-shift-timing-v11 {
    display:block !important;

    padding:12px 14px !important;
}


.machine-shift-intro-v11 {
    margin-bottom:10px;
}


.machine-shift-intro-v11 strong {
    display:block;

    color:#172235;

    font-size:12px;

    font-weight:700;
}


.machine-shift-intro-v11 small {
    display:block;

    margin-top:3px;

    color:#64748b;

    font-size:10px;

    font-weight:400;
}


.machine-shift-controls-v11 {
    display:grid;

    grid-template-columns:
        minmax(150px, 1fr)
        minmax(135px, .8fr)
        minmax(135px, .8fr);

    gap:9px;

    align-items:end;
}


.machine-shift-control-v11 {
    min-width:0;
}


.machine-shift-control-v11 label {
    display:flex;

    align-items:center;

    gap:5px;

    margin-bottom:5px;

    color:#475569;

    font-size:9px;

    font-weight:700;

    text-transform:uppercase;

    letter-spacing:.03em;
}


.machine-shift-control-v11 label i {
    color:#2f6397;

    font-size:10px;
}


.machine-shift-timing-v11
.machine-shift-select-v1,
.machine-shift-time-v11 {
    width:100% !important;

    min-width:0 !important;
    min-height:38px;

    margin:0;

    padding:7px 9px;

    border:1px solid #cbd5e1;

    border-radius:6px;

    background:#ffffff;

    color:#172235;

    font-family:inherit !important;

    font-size:12px;

    font-weight:600;

    outline:none;

    box-shadow:none;
}


.machine-shift-timing-v11
.machine-shift-select-v1:focus,
.machine-shift-time-v11:focus {
    border-color:#2f6397;

    box-shadow:
        0 0 0 2px
        rgba(47, 99, 151, .10);
}


.machine-shift-time-v11:disabled {
    cursor:not-allowed;

    background:#f1f5f9;

    color:#94a3b8;
}


.machine-shift-duration-v11 {
    display:flex;

    align-items:center;

    gap:6px;

    margin-top:8px;

    color:#64748b;

    font-size:10px;

    font-weight:500;
}


.machine-shift-duration-v11 i {
    color:#2f6397;
}


.machine-shift-duration-v11.ready {
    color:#166534;

    font-weight:600;
}


.machine-shift-duration-v11.ready i {
    color:#16a34a;
}


@media(max-width:650px) {

    .machine-shift-controls-v11 {
        grid-template-columns:1fr;
    }
}





/* MACHINE_OEE_MACHINE_LEVEL_LOSSES_V13_CSS */

.oee-machine-loss-only-v13 {
    margin-top:14px;

    padding:14px;

    border:
        1px solid
        var(--border, #dbe3ec);

    border-radius:8px;

    background:#ffffff;

    font-family:
        "IBM Plex Sans",
        sans-serif;
}


.oee-machine-loss-badge-v13 {
    display:inline-flex;

    align-items:center;

    gap:5px;

    padding:4px 8px;

    border-radius:5px;

    background:#eef4ff;

    color:
        var(--accent, #2f6397);

    font-size:9px;

    font-weight:700;
}


.oee-machine-loss-note-v13 {
    display:flex;

    align-items:flex-start;

    gap:7px;

    margin-bottom:10px;

    padding:8px 10px;

    border:
        1px solid #dbe7f3;

    border-radius:6px;

    background:#f7fafd;

    color:#516174;

    font-size:10px;

    line-height:1.45;
}


.oee-machine-loss-note-v13 i {
    margin-top:1px;

    color:
        var(--accent, #2f6397);
}


.oee-machine-loss-only-v13
.oee-direct-loss-tools-v3 {
    margin-bottom:8px;
}


.oee-machine-loss-only-v13
#oee-direct-loss-grid-v3 {
    margin-top:0;
}





/* MACHINE_OEE_LOSS_UI_CLEANUP_V17 */

.oee-loss-period-v16 {
    margin:0 0 10px;

    padding:10px 12px;

    border:
        1px solid
        var(--border,#d0d7e2);

    border-radius:7px;

    background:#f8fafc;
}


.oee-loss-period-grid-v16 {
    display:grid;

    grid-template-columns:
        minmax(150px,1fr)
        minmax(150px,1fr)
        minmax(150px,1fr);

    gap:10px;

    align-items:end;
}


.oee-loss-period-field-v16 label {
    display:block;

    margin-bottom:5px;

    color:#475569;

    font-size:9px;
    font-weight:800;

    text-transform:uppercase;

    letter-spacing:.03em;
}


.oee-loss-period-field-v16 input {
    width:100%;

    min-height:38px;

    padding:7px 10px;

    border:
        1px solid
        var(--border,#d0d7e2);

    border-radius:6px;

    background:#ffffff;

    color:
        var(--text,#0f2a4d);

    font-family:inherit;

    font-size:12px;
    font-weight:700;
}


.oee-loss-period-field-v16 input:focus {
    outline:none;

    border-color:
        var(--accent,#2f6397);

    box-shadow:
        0 0 0 2px
        rgba(47,99,151,.10);
}


/* Collapse / Show Losses control */

.oee-direct-loss-toggle-v3,
#machine-oee-loss-toggle-v13 {
    display:inline-flex;

    align-items:center;
    justify-content:center;

    gap:7px;

    min-height:32px;

    padding:6px 11px;

    border:
        1px solid
        #bfd0e4;

    border-radius:6px;

    background:#eef4fb;

    color:#173d68;

    font-family:inherit;

    font-size:10px;
    font-weight:800;

    cursor:pointer;

    transition:
        background .15s ease,
        border-color .15s ease,
        box-shadow .15s ease;
}


.oee-direct-loss-toggle-v3:hover,
#machine-oee-loss-toggle-v13:hover {
    background:#e2edf9;

    border-color:#9fb9d6;
}


.oee-direct-loss-toggle-v3:focus,
#machine-oee-loss-toggle-v13:focus {
    outline:none;

    box-shadow:
        0 0 0 2px
        rgba(47,99,151,.12);
}


.oee-direct-loss-toggle-v3 i,
#machine-oee-loss-toggle-v13 i {
    color:#173d68;

    font-size:11px;
}


@media(max-width:650px) {

    .oee-loss-period-grid-v16 {
        grid-template-columns:1fr;
    }
}


/* V17 CSS END */


/* V13 END */




/* OEE_OPERATOR_TEXTBOX_V25_CSS */

.actual-operator-box-v1 {
    display:block !important;
}


.actual-operator-fields-v25 {
    display:grid;

    grid-template-columns:
        minmax(110px,.35fr)
        minmax(240px,1fr);

    gap:10px;

    width:100%;

    margin-top:8px;
}


.actual-operator-field-v25 label {
    display:block;

    margin-bottom:4px;

    color:#475569;

    font-size:9px;
    font-weight:800;

    text-transform:uppercase;

    letter-spacing:.03em;
}


.actual-operator-field-v25 input {
    width:100%;

    min-height:38px;

    padding:7px 10px;

    border:
        1px solid
        var(--border,#d0d7e2);

    border-radius:6px;

    background:#ffffff;

    color:
        var(--text,#0f2a4d);

    font-family:
        "IBM Plex Sans",
        sans-serif;

    font-size:12px;

    font-weight:700;

    outline:none;
}


.actual-operator-field-v25 input:focus {
    border-color:
        var(--accent,#2f6397);

    box-shadow:
        0 0 0 2px
        rgba(47,99,151,.10);
}


@media(max-width:650px) {

    .actual-operator-fields-v25 {
        grid-template-columns:1fr;
    }
}


/* LIVE KPI V25 */

.machine-live-three-v25 {
    display:grid;

    grid-template-columns:
        repeat(3,minmax(0,1fr));

    gap:8px;
}


.machine-live-kpi-v25 {
    padding:12px 8px;

    border:
        1px solid
        #e2e8f0;

    border-radius:8px;

    background:#f8fafc;

    text-align:center;
}


.machine-live-kpi-v25 span {
    display:block;

    color:#64748b;

    font-size:9px;

    font-weight:800;

    text-transform:uppercase;
}


.machine-live-kpi-v25 strong {
    display:block;

    margin-top:5px;

    color:#173d68;

    font-size:20px;

    font-weight:800;
}


.machine-live-kpi-v25.primary {
    background:#173d68;

    border-color:#173d68;
}


.machine-live-kpi-v25.primary span,
.machine-live-kpi-v25.primary strong {
    color:#ffffff;
}


@media(max-width:500px) {

    .machine-live-three-v25 {
        grid-template-columns:1fr;
    }
}



/* MACHINE_OEE_INLINE_MACHINE_SWITCH_V27 */

.oee-machine-switcher-v27 {
    margin-bottom:12px;

    padding:10px 12px;

    border:1px solid #dfe5ed;

    border-radius:8px;

    background:#ffffff;
}


.oee-machine-switcher-head-v27 {
    display:flex;

    align-items:center;
    justify-content:space-between;

    gap:10px;

    margin-bottom:8px;
}


.oee-machine-switcher-title-v27 {
    display:flex;

    align-items:center;

    gap:7px;

    color:#173d68;

    font-size:11px;
    font-weight:800;
}


.oee-machine-switcher-title-v27 i {
    font-size:12px;
}


.oee-machine-switcher-zone-v27 {
    color:#64748b;

    font-size:10px;
    font-weight:700;
}


.oee-machine-switcher-list-v27 {
    display:flex;

    flex-wrap:wrap;

    gap:6px;
}


.oee-machine-btn-v27 {
    display:inline-flex;

    align-items:center;

    gap:6px;

    min-height:34px;

    padding:6px 9px;

    border:1px solid #cbd5e1;

    border-radius:6px;

    background:#f8fafc;

    color:#334155;

    font-family:
        "IBM Plex Sans",
        sans-serif;

    font-size:10px;

    font-weight:700;

    cursor:pointer;
}


.oee-machine-btn-v27:hover {
    border-color:#93aecb;

    background:#eef4fb;

    color:#173d68;
}


.oee-machine-btn-v27.active {
    border-color:#173d68;

    background:#173d68;

    color:#ffffff;

    cursor:default;
}


.oee-machine-btn-v27.loading {
    opacity:.55;

    cursor:wait;
}


.oee-machine-btn-no-v27 {
    font-weight:800;
}


.oee-machine-btn-name-v27 {
    max-width:120px;

    overflow:hidden;

    text-overflow:ellipsis;

    white-space:nowrap;

    opacity:.82;
}


@media(max-width:650px) {

    .oee-machine-switcher-head-v27 {
        align-items:flex-start;

        flex-direction:column;
    }


    .oee-machine-btn-v27 {
        flex:1 1 140px;

        justify-content:flex-start;
    }
}


/* V27 END */



/* MACHINE_OEE_MODE_VISIBILITY_AND_LIVE_RIGHT_V31 */

/*
 * Only one Start/End pair is visible at a time.
 */
.oee-time-hidden-v31 {
    display:none !important;
}


/*
 * Keep Live OEE compact and clearly visible
 * in the existing right-side column.
 */
#machine-live-oee-host-v1 {
    width:100%;
}


#machine-live-oee-host-v1
.machine-live-oee-v1 {
    margin-top:12px;
    width:100%;
}


@media(min-width:851px) {

    .workspace-grid > aside {
        position:relative;
    }


    #machine-live-oee-host-v1 {
        position:relative;
        z-index:2;
    }
}


/* V31 END */



/* MACHINE_OEE_SAVE_CONFIRM_AND_KPI_V32 */


.machine-live-v32 {
    width:100%;

    margin-top:12px;

    background:#ffffff;

    border:1px solid #dfe5ed;

    border-radius:10px;

    padding:13px;
}


.machine-live-head-v32 {
    display:flex;

    align-items:center;

    justify-content:space-between;

    gap:8px;

    margin-bottom:10px;
}


.machine-live-head-v32 strong {
    color:#172235;

    font-size:13px;
}


.machine-live-head-v32 span {
    color:#64748b;

    font-size:9px;

    font-weight:700;
}


.machine-live-kpis-v32 {
    display:grid;

    grid-template-columns:
        repeat(
            3,
            minmax(0,1fr)
        );

    gap:7px;
}


.machine-live-kpi-v32 {
    min-width:0;

    padding:10px 5px;

    text-align:center;

    border:1px solid #e2e8f0;

    border-radius:8px;

    background:#f8fafc;
}


.machine-live-kpi-v32 span {
    display:block;

    color:#64748b;

    font-size:8px;

    font-weight:800;

    text-transform:uppercase;
}


.machine-live-kpi-v32 strong {
    display:block;

    margin-top:5px;

    color:#173d68;

    font-size:16px;

    font-weight:900;

    white-space:nowrap;
}


.machine-live-kpi-v32.oee strong {
    color:#15803d;
}


.machine-live-note-v32 {
    margin-top:8px;

    color:#64748b;

    font-size:9px;

    line-height:1.4;
}


.oee-db-confirm-v32 {
    display:flex !important;

    align-items:center;

    gap:6px;

    padding:8px 10px;

    border:1px solid #bbf7d0;

    border-radius:7px;

    background:#f0fdf4;

    color:#166534 !important;

    font-weight:800;
}


#machine-oee-db-toast-v32 {
    position:fixed;

    right:20px;

    bottom:20px;

    z-index:99999;

    min-width:270px;

    max-width:360px;

    display:none;

    align-items:flex-start;

    gap:10px;

    padding:13px 15px;

    background:#ffffff;

    border:1px solid #86efac;

    border-radius:9px;

    box-shadow:
        0 12px 28px
        rgba(15,23,42,.16);
}


#machine-oee-db-toast-v32.show {
    display:flex;
}


#machine-oee-db-toast-v32 i {
    margin-top:2px;

    color:#15803d;

    font-size:20px;
}


#machine-oee-db-toast-v32 strong {
    display:block;

    color:#166534;

    font-size:12px;
}


#machine-oee-db-toast-v32 span {
    display:block;

    margin-top:3px;

    color:#475569;

    font-size:10px;
}


@media(max-width:600px) {

    #machine-oee-db-toast-v32 {
        left:12px;
        right:12px;
        bottom:12px;

        min-width:0;
        max-width:none;
    }
}



/* MACHINE_OEE_JMS_UI_CONSISTENCY_V33 */

/*
 * Internal source only.
 * The real controls are moved into Direct Entry V3.
 */
#machine-oee-production-entry-v1 {
    display: none !important;
}


/*
 * V32 custom OEE toast is retired.
 * OEE now uses the normal JMS toast.
 */
#machine-oee-db-toast-v32 {
    display: none !important;
}


/*
 * Same shared toast appearance used by JMS base.css.
 */
.toast {
    position: fixed;
    bottom: 24px;
    right: 24px;

    padding: 14px 20px;

    border-radius: 6px;

    font-size: 14px;
    font-weight: 500;

    display: none;

    z-index: 999;
}


.toast.success {
    background: #f0fdf4;
    border: 1px solid #86efac;
    color: var(--success, #15803d);
}


.toast.error {
    background: #fef2f2;
    border: 1px solid #fca5a5;
    color: var(--danger, #b91c1c);
}


.toast.info {
    background: #ecfdf5;
    border: 1px solid #86efac;
    color: #047857;

    box-shadow:
        0 10px 28px
        rgba(4, 120, 87, 0.18);
}


.toast.warning {
    background: #fffbeb;
    border: 1px solid #fcd34d;
    color: #92400e;

    box-shadow:
        0 10px 28px
        rgba(146, 64, 14, 0.16);
}


/* V33 END */



/* MACHINE_OEE_DURATION_HMS_V34 */

/*
 * Existing minute/second controls remain in DOM because
 * current backend/save logic uses them.
 *
 * V34 only replaces their visible presentation.
 */
.oee-duration-source-hidden-v34 {
    display:none !important;
}


/*
 * This input is intentionally a direct child of the
 * existing oee-direct-field-v3 so it receives the same
 * visual treatment as Start Time and Stop Time.
 */
.oee-duration-hms-v34 {
    width:100%;
}


/* V34 END */

</style>

</head>


<body>


<div class="oee-shell">


    <div class="oee-topbar">

        <a
            class="back-link"
            href="/page3"
        >
            <i
                class="fa fa-arrow-left"
                aria-hidden="true"
            ></i>

            <span>
                Back to Machine Selection
            </span>
        </a>


        <div class="machine-chip">

            {{ machine.machine_no }}

            <i
                class="fa fa-cog"
                aria-hidden="true"
            ></i>

            {{ machine.machine_name }}

        </div>

    </div>


    <section class="machine-header">


        <div class="machine-title">

            <h1>
                OEE Operator Entry
            </h1>

            <p>
                Machine-wise production and OEE workspace
            </p>

        </div>


        <div class="machine-context">


            <div class="context-box">

                <span>
                    Zone
                </span>

                <strong>
                    {{ machine.zone or '-' }}
                </strong>

            </div>


            <div class="context-box">

                <span>
                    Category
                </span>

                <strong>
                    {{ machine.machine_category }}
                </strong>

            </div>


            <div class="context-box">

                <span>
                    Operator
                </span>

                <strong>
                    {{ operator_name }}
                </strong>

            </div>


        </div>


    </section>


    <div class="machine-ready">

        <span class="ready-dot"></span>

        Selected machine is locked for this workspace.

        Scan / enter the Job Card below.

    </div>


    <div class="workspace-grid">


        <main>


            <div
                id="machine-oee-actual-operator-host-v1"
            ></div>


            <div
                class="machine-shift-box-v1 machine-shift-timing-v11"
            >

                <div class="machine-shift-intro-v11">

                    <strong>
                        Current Shift
                    </strong>

                    <small>
                        Select shift. Start and end time fill automatically and remain editable.
                    </small>

                </div>


                <div class="machine-shift-controls-v11">

                    <div class="machine-shift-control-v11">

                        <label
                            for="machine-oee-shift-v1"
                        >

                            <i
                                class="fa fa-industry"
                                aria-hidden="true"
                            ></i>

                            Shift

                        </label>


                        <select
                            id="machine-oee-shift-v1"
                            class="machine-shift-select-v1"
                        >

                            <option value="">
                                -- Select Shift --
                            </option>

                            <option value="Shift 1">
                                Shift 1
                            </option>

                            <option value="Shift 2">
                                Shift 2
                            </option>


                        </select>

                    </div>


                    <div class="machine-shift-control-v11">

                        <label
                            for="machine-oee-shift-start-v11"
                        >

                            <i
                                class="fa fa-play-circle"
                                aria-hidden="true"
                            ></i>

                            Start Time

                        </label>


                        <input
                            id="machine-oee-shift-start-v11"
                            class="machine-shift-time-v11"
                            type="time"
                            disabled
                        >

                    </div>


                    <div class="machine-shift-control-v11">

                        <label
                            for="machine-oee-shift-end-v11"
                        >

                            <i
                                class="fa fa-stop-circle"
                                aria-hidden="true"
                            ></i>

                            End Time

                        </label>


                        <input
                            id="machine-oee-shift-end-v11"
                            class="machine-shift-time-v11"
                            type="time"
                            disabled
                        >

                    </div>

                </div>


                <div
                    id="machine-oee-shift-duration-v11"
                    class="machine-shift-duration-v11"
                >

                    <i
                        class="fa fa-clock-o"
                        aria-hidden="true"
                    ></i>

                    <span>
                        Select a shift to load the default time.
                    </span>

                </div>

            </div>


            <section class="card">


                <div class="card-head">

                    <h2>
                        Job Card
                    </h2>

                    <span class="tag">
                        SCAN / ENTER
                    </span>

                </div>


                <label
                    class="jc-label"
                    for="machine-oee-jc-input"
                >
                    Job Card No.
                </label>


                <div class="jc-search">

                    <input
                        id="machine-oee-jc-input"
                        type="text"
                        inputmode="numeric"
                        autocomplete="off"
                        placeholder="Scan or enter Job Card number"
                        autofocus
                    >


                    <button
                        id="machine-oee-fetch-btn"
                        type="button"
                    >
                        Fetch
                    </button>

                </div>


                <div class="helper">

                    Short JC numbers are supported.
                    Example: 112729 = 0000112729.

                </div>


                <div
                    id="machine-oee-jc-result-v1"
                    class="jc-result-v1"
                >

                    <div class="upcoming">

                        <strong>
                            Ready for Job Card
                        </strong>

                        <span>
                            Scan / enter the JC above.
                        </span>

                    </div>

                </div>


            </section>


        </main>


        <aside>


            <section class="card">

                <h3 class="machine-summary-title">
                    Machine Context
                </h3>


                <div class="summary-row">

                    <span>
                        Machine No.
                    </span>

                    <strong>
                        {{ machine.machine_no }}
                    </strong>

                </div>


                <div class="summary-row">

                    <span>
                        Machine
                    </span>

                    <strong>
                        {{ machine.machine_name }}
                    </strong>

                </div>


                <div class="summary-row">

                    <span>
                        Zone
                    </span>

                    <strong>
                        {{ machine.zone or '-' }}
                    </strong>

                </div>


                <div class="summary-row">

                    <span>
                        OEE Level
                    </span>

                    <strong>
                        Machine-wise
                    </strong>

                </div>


                <div class="summary-row">

                    <span>
                        Status
                    </span>

                    <strong class="status-open">
                        READY
                    </strong>

                </div>


            </section>


            <div
                id="machine-live-oee-host-v1"
            ></div>


        </aside>


    </div>


</div>


<script>

window.NMTG_MACHINE_OEE_CONTEXT = {
    machine_id:
        {{ machine.id | tojson }},

    machine_no:
        {{ machine.machine_no | tojson }},

    machine_name:
        {{ machine.machine_name | tojson }},

    machine_category:
        {{ machine.machine_category | tojson }},

    zone:
        {{ machine.zone | tojson }},

    is_zone_login:
        {{ (zone_login is not none) | tojson }}
};


const jcInput =
    document.getElementById(
        "machine-oee-jc-input"
    );


if (jcInput) {

    window.setTimeout(
        function() {
            jcInput.focus();
            jcInput.select();
        },
        100
    );

}



/* MACHINE_OEE_JC_FETCH_V1_START */

let machineOeePendingRunV1 = null;

let machineOeeCurrentFetchedJcV1 = null;

let machineOeeIncomingCardV1 = null;


/* ---------------------------------------------------------
 * HELPERS
 * --------------------------------------------------------- */

function machineOeeEscapeV1(value) {

    return String(
        value === null
        || value === undefined
            ? ""
            : value
    )
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
}


function machineOeeProcessCategoryV1(
    processName
) {

    const name = String(
        processName || ""
    )
        .trim()
        .toLowerCase();


    if (
        name.startsWith(
            "cnc machining"
        )
    ) {
        return "CNC";
    }


    if (
        name.startsWith(
            "vmc machining"
        )
    ) {
        return "VMC";
    }


    return "";
}


function machineOeeRequiredQtyV1(
    card
) {

    const jcQty =
        Number(
            card?.job_card_qty
            || 0
        );


    if (
        Number.isFinite(jcQty)
        &&
        jcQty > 0
    ) {
        return jcQty;
    }


    const soQty =
        Number(
            card?.so_qty
            || 0
        );


    return (
        Number.isFinite(soQty)
        &&
        soQty > 0
    )
        ? soQty
        : 0;
}


function machineOeeSetSearchEnabledV1(
    enabled
) {

    const input =
        document.getElementById(
            "machine-oee-jc-input"
        );


    const button =
        document.getElementById(
            "machine-oee-fetch-btn"
        );


    if (input) {
        input.disabled =
            !enabled;
    }


    if (button) {
        button.disabled =
            !enabled;

        button.style.cursor =
            enabled
                ? "pointer"
                : "not-allowed";

        button.style.opacity =
            enabled
                ? "1"
                : ".55";
    }


    if (
        enabled
        &&
        input
    ) {

        window.setTimeout(
            function() {
                input.focus();
                input.select();
            },
            80
        );
    }
}


/* ---------------------------------------------------------
 * CHECK IF THIS MACHINE ALREADY HAS PENDING WORK
 * --------------------------------------------------------- */

async function machineOeeCheckPendingV1() {

    const context =
        window.NMTG_MACHINE_OEE_CONTEXT;


    const resultHost =
        document.getElementById(
            "machine-oee-jc-result-v1"
        );


    if (
        !context
        ||
        !context.machine_id
        ||
        !resultHost
    ) {
        return;
    }


    try {

        const response =
            await fetch(
                "/api/oee-machine/pending/"
                +
                encodeURIComponent(
                    context.machine_id
                ),
                {
                    cache:"no-store"
                }
            );


        const data =
            await response.json();


        if (
            !response.ok
            ||
            data.success === false
        ) {

            throw new Error(
                data.error
                || "Unable to check machine status."
            );
        }


        machineOeePendingRunV1 =
            data.pending_run
            || null;


        if (
            data.has_pending_run
            &&
            machineOeePendingRunV1
        ) {

            machineOeeSetSearchEnabledV1(
                false
            );


            const run =
                machineOeePendingRunV1;


            resultHost.innerHTML = `

                <div class="pending-machine-v1">

                    <h3>
                        Current / Previous Machine Entry
                    </h3>

                    <p>
                        This machine already has an unfinished
                        Job Card. Continue or complete this work
                        before starting another JC.
                    </p>

                    <div
                        class="jc-state-grid-v1"
                        style="margin-top:11px;"
                    >

                        <div class="jc-info-v1">
                            <span>Job Card</span>
                            <strong>
                                ${machineOeeEscapeV1(
                                    run.job_card_no
                                )}
                            </strong>
                        </div>


                        <div class="jc-info-v1">
                            <span>Process</span>
                            <strong>
                                ${machineOeeEscapeV1(
                                    run.process_name
                                )}
                            </strong>
                        </div>


                        <div class="jc-info-v1">
                            <span>Status</span>
                            <strong>
                                ${machineOeeEscapeV1(
                                    run.run_status
                                )}
                            </strong>
                        </div>


                        <div class="jc-info-v1">
                            <span>Operator</span>
                            <strong>
                                ${machineOeeEscapeV1(
                                    run.operator_name
                                    || "-"
                                )}
                            </strong>
                        </div>


                        <div class="jc-info-v1">
                            <span>Started</span>
                            <strong>
                                ${machineOeeEscapeV1(
                                    run.started_at
                                    || "-"
                                )}
                            </strong>
                        </div>


                        <div class="jc-info-v1">
                            <span>Previous Shift</span>
                            <strong>
                                ${machineOeeEscapeV1(
                                    run.shift_name
                                    || "-"
                                )}
                            </strong>
                        </div>

                    </div>

                </div>
            `;


            return;
        }


        machineOeeSetSearchEnabledV1(
            true
        );


        resultHost.innerHTML = `

            <div class="upcoming">

                <strong>
                    Machine Ready
                </strong>

                <span>
                    Scan / enter Job Card number.
                </span>

            </div>
        `;


    } catch (error) {

        machineOeeSetSearchEnabledV1(
            false
        );


        resultHost.innerHTML = `

            <div class="machine-page-error-v1">
                ${machineOeeEscapeV1(
                    error.message
                    || "Unable to check machine status."
                )}
            </div>
        `;
    }
}


/* ---------------------------------------------------------
 * FETCH JC
 *
 * IMPORTANT:
 * Uses EXISTING proven JMS APIs.
 * --------------------------------------------------------- */

async function machineOeeFetchJcV1() {

    if (machineOeePendingRunV1) {
        return;
    }


    const context =
        window.NMTG_MACHINE_OEE_CONTEXT;


    const input =
        document.getElementById(
            "machine-oee-jc-input"
        );


    const resultHost =
        document.getElementById(
            "machine-oee-jc-result-v1"
        );


    const enteredJc =
        String(
            input?.value
            || ""
        ).trim();


    if (!enteredJc) {

        resultHost.innerHTML = `

            <div class="jc-state-v1 error">

                Please enter Job Card number.

            </div>
        `;

        input?.focus();

        return;
    }


    resultHost.innerHTML = `

        <div class="upcoming">

            <strong>
                Checking Job Card...
            </strong>

            <span>
                Please wait.
            </span>

        </div>
    `;


    try {

        /*
         * Step 1:
         * Existing quality-check fetch resolves
         * shortened JC numbers correctly.
         */
        const fetchResponse =
            await fetch(
                "/api/quality_check/fetch/"
                +
                encodeURIComponent(
                    enteredJc
                ),
                {
                    cache:"no-store"
                }
            );


        const fetchData =
            await fetchResponse.json();


        /*
         * OEE_UI_CLEANUP_V57
         *
         * Keep the already-fetched full JC response for
         * presentation only.
         */
        window.machineOeeUiFetchedDetailsV57 =
            fetchData;



        if (
            !fetchResponse.ok
            ||
            fetchData.success === false
        ) {

            throw new Error(
                fetchData.error
                || fetchData.message
                || "Job Card not found."
            );
        }


        const actualJc =
            String(
                fetchData?.job_card?.job_card_no
                || enteredJc
            ).trim();


        /*
         * Step 2:
         * Reuse existing current/incoming operator
         * queue logic.
         */
        const queueResponse =
            await fetch(
                "/api/operator/job_cards?include_incoming=1",
                {
                    cache:"no-store"
                }
            );


        const queueData =
            await queueResponse.json();


        if (
            !queueResponse.ok
            ||
            queueData.success === false
        ) {

            throw new Error(
                queueData.error
                || "Unable to validate Job Card process."
            );
        }


        const queueCards =
            queueData.job_cards
            || [];


        const currentCard =
            queueCards.find(
                function(card) {

                    return (
                        card?.is_incoming !== true
                        &&
                        String(
                            card?.job_card_no
                            || ""
                        ).trim()
                        === actualJc
                    );
                }
            );


        const incomingCard =
            queueCards.find(
                function(card) {

                    return (
                        card?.is_incoming === true
                        &&
                        String(
                            card?.job_card_no
                            || ""
                        ).trim()
                        === actualJc
                    );
                }
            );


        /*
         * CURRENT CNC/VMC PROCESS
         */
        if (currentCard) {

            const currentProcess =
                String(
                    currentCard.current_process
                    || currentCard.wip_status
                    || ""
                ).trim();


            const requiredCategory =
                machineOeeProcessCategoryV1(
                    currentProcess
                );


            if (
                requiredCategory
                &&
                requiredCategory
                !== String(
                    context.machine_category
                    || ""
                ).trim().toUpperCase()
            ) {

                throw new Error(
                    `${actualJc} is at ${currentProcess}. `
                    +
                    `Please select a ${requiredCategory} machine.`
                );
            }


            machineOeeCurrentFetchedJcV1 =
                currentCard;


            machineOeeIncomingCardV1 =
                null;


            input.value =
                actualJc;


            resultHost.innerHTML = `

                <div class="jc-state-v1 success">

                    <div class="jc-state-head-v1">

                        <strong>
                            Job Card Ready
                        </strong>

                        <span class="jc-status-chip-v1">
                            CURRENT PROCESS
                        </span>

                    </div>


                    <div class="jc-state-grid-v1">

                        <div class="jc-info-v1">
                            <span>Job Card</span>
                            <strong>
                                ${machineOeeEscapeV1(
                                    actualJc
                                )}
                            </strong>
                        </div>


                        <div class="jc-info-v1">
                            <span>Item</span>
                            <strong>
                                ${machineOeeEscapeV1(
                                    currentCard.item_name
                                    || "-"
                                )}
                            </strong>
                        </div>


                        <div class="jc-info-v1">
                            <span>Current Process</span>
                            <strong>
                                ${machineOeeEscapeV1(
                                    currentProcess
                                )}
                            </strong>
                        </div>


                        <div class="jc-info-v1">
                            <span>Next Process</span>
                            <strong>
                                ${machineOeeEscapeV1(
                                    currentCard.next_process
                                    || "Store"
                                )}
                            </strong>
                        </div>


                        <div class="jc-info-v1">
                            <span>Available Qty</span>
                            <strong>
                                ${machineOeeEscapeV1(
                                    currentCard.available_qty
                                    ??
                                    currentCard.job_card_qty
                                    ??
                                    currentCard.so_qty
                                    ??
                                    "-"
                                )}
                            </strong>
                        </div>


                        <div class="jc-info-v1">
                            <span>Selected Machine</span>
                            <strong>
                                ${machineOeeEscapeV1(
                                    context.machine_no
                                )}
                            </strong>
                        </div>

                    </div>


                    <div class="jc-action-v1">

                        <button
                            type="button"
                            class="jc-ready-btn-v1"
                            disabled
                        >
                            <i
                                class="fa fa-play-circle"
                                aria-hidden="true"
                            ></i>

                            <span>
                                Ready to Start
                            </span>
                        </button>

                    </div>

                </div>
            `;


            return;
        }


        /*
         * IMMEDIATE PREVIOUS PROCESS PENDING
         */
        if (incomingCard) {

            const incomingProcess =
                String(
                    incomingCard.incoming_for_process
                    || incomingCard.next_process
                    || ""
                ).trim();


            const requiredCategory =
                machineOeeProcessCategoryV1(
                    incomingProcess
                );


            if (
                requiredCategory
                &&
                requiredCategory
                !== String(
                    context.machine_category
                    || ""
                ).trim().toUpperCase()
            ) {

                throw new Error(
                    `${actualJc} is incoming for ${incomingProcess}. `
                    +
                    `Please select a ${requiredCategory} machine.`
                );
            }


            machineOeeCurrentFetchedJcV1 =
                null;


            machineOeeIncomingCardV1 =
                incomingCard;


            input.value =
                actualJc;


            const requiredQty =
                machineOeeRequiredQtyV1(
                    incomingCard
                );


            resultHost.innerHTML = `

                <div class="jc-state-v1 warning">

                    <div class="jc-state-head-v1">

                        <strong>
                            Receive Material Required
                        </strong>

                        <span class="jc-status-chip-v1">
                            PREVIOUS PROCESS PENDING
                        </span>

                    </div>


                    <div class="jc-state-grid-v1">

                        <div class="jc-info-v1">
                            <span>Job Card</span>
                            <strong>
                                ${machineOeeEscapeV1(
                                    actualJc
                                )}
                            </strong>
                        </div>


                        <div class="jc-info-v1">
                            <span>Previous Process</span>
                            <strong>
                                ${machineOeeEscapeV1(
                                    incomingCard.previous_process_to_complete
                                    || incomingCard.current_process
                                    || "-"
                                )}
                            </strong>
                        </div>


                        <div class="jc-info-v1">
                            <span>Your Process</span>
                            <strong>
                                ${machineOeeEscapeV1(
                                    incomingProcess
                                )}
                            </strong>
                        </div>


                        <div class="jc-info-v1">
                            <span>Required Qty</span>
                            <strong>
                                ${machineOeeEscapeV1(
                                    requiredQty
                                )}
                            </strong>
                        </div>


                        <div class="jc-info-v1">

                            <span>
                                Received Qty
                            </span>

                            <input
                                id="machine-oee-received-qty-v1"
                                class="receive-qty-v1"
                                type="number"
                                min="0"
                                step="1"
                                value="${machineOeeEscapeV1(
                                    requiredQty
                                )}"
                            >

                        </div>


                        <div class="jc-info-v1">
                            <span>Selected Machine</span>
                            <strong>
                                ${machineOeeEscapeV1(
                                    context.machine_no
                                )}
                            </strong>
                        </div>

                    </div>


                    <div class="jc-action-v1">

                        <button
                            type="button"
                            class="jc-receive-btn-v1"
                            onclick="
                                machineOeeReceiveMaterialV1()
                            "
                        >
                            Receive Material
                        </button>

                    </div>

                </div>
            `;


            return;
        }


        throw new Error(
            `${actualJc} is not currently available `
            +
            `for your CNC/VMC operator process.`
        );

    } catch (error) {

        resultHost.innerHTML = `

            <div class="jc-state-v1 error">
                ${machineOeeEscapeV1(
                    error.message
                    || "Unable to fetch Job Card."
                )}
            </div>
        `;
    }
}


/* MACHINE_OEE_JC_FETCH_V1_END */




/* MACHINE_OEE_RECEIVE_MATERIAL_V1_START */

async function machineOeeReceiveMaterialV1() {

    const card =
        machineOeeIncomingCardV1;


    if (!card) {
        return;
    }


    const qtyInput =
        document.getElementById(
            "machine-oee-received-qty-v1"
        );


    const requiredQty =
        machineOeeRequiredQtyV1(
            card
        );


    const receivedQty =
        Number(
            qtyInput?.value
            || 0
        );


    if (
        !Number.isInteger(
            receivedQty
        )
        ||
        receivedQty <= 0
    ) {

        alert(
            "Enter valid Received Qty."
        );

        qtyInput?.focus();

        return;
    }


    if (
        receivedQty
        !== requiredQty
    ) {

        alert(
            `Full Qty ${requiredQty} must be received.`
        );

        qtyInput?.focus();

        return;
    }


    const incomingProcess =
        String(
            card.incoming_for_process
            || card.next_process
            || ""
        ).trim();


    if (!incomingProcess) {

        alert(
            "Incoming CNC/VMC process was not found."
        );

        return;
    }


    const resultHost =
        document.getElementById(
            "machine-oee-jc-result-v1"
        );


    resultHost.innerHTML = `

        <div class="upcoming">

            <strong>
                Receiving Material...
            </strong>

            <span>
                Please wait.
            </span>

        </div>
    `;


    try {

        const response =
            await fetch(
                "/api/wip/update",
                {
                    method:"POST",

                    headers:{
                        "Content-Type":
                            "application/json"
                    },

                    body:JSON.stringify({
                        job_card_no:
                            card.job_card_no,

                        item_name:
                            card.item_name,

                        new_stage:
                            incomingProcess,

                        incoming_receipt:
                            true,

                        received_qty:
                            receivedQty,

                        stage_remark:
                            `Material received by CNC/VMC operator. `
                            +
                            `Received Qty ${receivedQty}/${requiredQty}.`
                    })
                }
            );


        const data =
            await response.json();


        if (
            !response.ok
            ||
            data.success === false
        ) {

            throw new Error(
                data.error
                || data.message
                || "Receive Material failed."
            );
        }


        machineOeeIncomingCardV1 =
            null;


        /*
         * Re-fetch same JC.
         * It should now appear as current CNC/VMC.
         */
        await machineOeeFetchJcV1();


    } catch (error) {

        resultHost.innerHTML = `

            <div class="jc-state-v1 error">

                ${machineOeeEscapeV1(
                    error.message
                    || "Receive Material failed."
                )}

            </div>
        `;
    }
}


