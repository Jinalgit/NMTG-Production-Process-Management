:root {
    --bg:#f4f7fb;
    --panel:#ffffff;
    --ink:#172235;
    --muted:#6b7280;
    --line:#dfe5ed;
    --brand:#173d68;
    --blue:#2563eb;
    --green:#15803d;
    --soft-blue:#eef4ff;
}


* {
    box-sizing:border-box;
}


body {
    margin:0;

    background:var(--bg);

    color:var(--ink);

    font-family:
        "IBM Plex Sans",
        sans-serif;
}


.oee-shell {
    width:min(1120px, 96%);

    margin:0 auto;

    padding:22px 0 40px;
}


/* =========================================================
   HEADER
   ========================================================= */

.oee-topbar {
    display:flex;

    justify-content:space-between;
    align-items:center;

    gap:16px;

    margin-bottom:16px;
}


.back-link {
    display:inline-flex;

    align-items:center;

    gap:7px;

    text-decoration:none;

    color:#475569;

    font-size:12px;
    font-weight:800;
}


.back-link:hover {
    color:var(--blue);
}


.machine-chip {
    display:inline-flex;

    align-items:center;

    gap:8px;

    padding:9px 14px;

    background:var(--brand);

    border-radius:999px;

    color:white;

    font-size:12px;
    font-weight:900;
}


/* =========================================================
   MACHINE HEADER
   ========================================================= */

.machine-header {
    display:flex;

    justify-content:space-between;
    align-items:flex-start;

    gap:20px;

    padding:20px;

    background:white;

    border:1px solid var(--line);

    border-radius:14px;

    margin-bottom:15px;
}


.machine-title h1 {
    margin:0;

    font-size:24px;

    color:#172235;
}


.machine-title p {
    margin:5px 0 0;

    color:var(--muted);

    font-size:12px;
}


.machine-context {
    display:grid;

    grid-template-columns:
        repeat(3, minmax(110px,1fr));

    gap:8px;

    min-width:390px;
}


.context-box {
    padding:10px 12px;

    border:1px solid #e2e8f0;

    border-radius:9px;

    background:#f8fafc;
}


.context-box span {
    display:block;

    color:#64748b;

    font-size:9px;

    font-weight:900;

    text-transform:uppercase;

    letter-spacing:.04em;
}


.context-box strong {
    display:block;

    margin-top:4px;

    color:#172235;

    font-size:13px;

    font-weight:900;
}


/* =========================================================
   STATUS
   ========================================================= */

.machine-ready {
    display:flex;

    align-items:center;

    gap:10px;

    padding:12px 14px;

    margin-bottom:15px;

    background:#f0fdf4;

    border:1px solid #bbf7d0;

    border-radius:11px;

    color:#166534;

    font-size:12px;

    font-weight:800;
}


.ready-dot {
    width:9px;
    height:9px;

    flex:none;

    border-radius:50%;

    background:#22c55e;
}


/* =========================================================
   MAIN PLACEHOLDER
   ========================================================= */

.workspace-grid {
    display:grid;

    grid-template-columns:
        minmax(0,1fr)
        300px;

    gap:14px;

    align-items:start;
}


.card {
    background:white;

    border:1px solid var(--line);

    border-radius:14px;

    padding:18px;
}


.card-head {
    display:flex;

    align-items:center;

    justify-content:space-between;

    gap:10px;

    margin-bottom:14px;
}


.card-head h2 {
    margin:0;

    font-size:16px;
}


.tag {
    padding:5px 9px;

    border-radius:999px;

    background:var(--soft-blue);

    color:var(--blue);

    font-size:10px;

    font-weight:900;
}


/* =========================================================
   JC SEARCH
   ========================================================= */

.jc-label {
    display:block;

    color:#475569;

    font-size:10px;

    font-weight:900;

    text-transform:uppercase;

    letter-spacing:.04em;

    margin-bottom:6px;
}


.jc-search {
    display:grid;

    grid-template-columns:
        minmax(0,1fr)
        auto;

    gap:8px;
}


.jc-search input {
    width:100%;

    min-height:46px;

    border:1px solid #cbd5e1;

    border-radius:10px;

    padding:10px 13px;

    color:#172235;

    font-size:16px;

    font-weight:800;

    outline:none;
}


.jc-search input:focus {
    border-color:#2563eb;

    box-shadow:
        0 0 0 3px
        rgba(37,99,235,.10);
}


#machine-oee-fetch-btn {
    display: none !important;
}

/* Current Process editable combo -- V58 running card */
.oee-process-cell-v58 { position: relative; }

.oee-process-input-v58 {
    display: block;
    width: 100%;
    margin-top: 2px;
    padding: 3px 6px;
    font: inherit;
    font-size: inherit;
    font-weight: 600;
    color: inherit;
    background: transparent;
    border: 1px solid rgba(128,128,128,0.35);
    border-radius: 4px;
    outline: none;
    box-sizing: border-box;
    cursor: pointer;
}

.oee-process-input-v58:focus {
    border-color: #2563eb;
    background: var(--card-bg, #fff);
}

.oee-process-input-v58:disabled {
    opacity: 0.5;
    cursor: wait;
}

.jc-search button {
    min-width:95px;

    border:0;

    border-radius:10px;

    background:#173d68;

    color:white;

    font-weight:900;

    padding:10px 17px;

    cursor:not-allowed;

    opacity:.55;
}


.helper {
    margin-top:7px;

    color:#64748b;

    font-size:11px;
}


/* =========================================================
   RIGHT SIDE
   ========================================================= */

.machine-summary-title {
    margin:0 0 13px;

    font-size:14px;
}


.summary-row {
    display:flex;

    align-items:center;
    justify-content:space-between;

    gap:10px;

    padding:9px 0;

    border-bottom:1px solid #edf1f5;

    font-size:11px;
}


.summary-row:last-child {
    border-bottom:0;
}


.summary-row span {
    color:#64748b;
}


.summary-row strong {
    color:#172235;

    text-align:right;
}


.status-open {
    color:var(--green) !important;
}


/* =========================================================
   UPCOMING WORKSPACE
   ========================================================= */

.upcoming {
    margin-top:14px;

    border:1px dashed #cbd5e1;

    border-radius:11px;

    padding:18px;

    text-align:center;

    color:#94a3b8;

    background:#fafbfd;
}


.upcoming strong {
    display:block;

    color:#64748b;

    font-size:12px;

    margin-bottom:4px;
}


.upcoming span {
    font-size:10px;
}


/* =========================================================
   RESPONSIVE
   ========================================================= */

@media(max-width:850px) {

    .machine-header {
        flex-direction:column;
    }


    .machine-context {
        width:100%;

        min-width:0;
    }


    .workspace-grid {
        grid-template-columns:1fr;
    }

}


@media(max-width:560px) {

    .machine-context {
        grid-template-columns:1fr;
    }


    .jc-search {
        grid-template-columns:1fr;
    }


    #machine-oee-fetch-btn {
    display: none !important;
}

.jc-search button {
        min-height:44px;
    }

}



