    function statusBadge(status) {
      const s = String(status || "").toUpperCase();
      if (!s) return "";
      let ds = "ok";
      if (s === "AVAILABLE") ds = "ok";
      else if (s === "IN USE" || s === "IN_USE" || s === "ASSIGNED")
        ds = "info";
      else if (s === "SCRAP" || s === "SCRAPPED") ds = "err";
      else if (s === "REGRIND" || s === "SEND_FOR_REGRIND") ds = "warn";
      else ds = "info";
      return "<span class='erp-badge' data-status='" + ds + "'>" + ERP.esc(s) + "</span>";
    }

    
    // ============================================================
    // SHIFT_TIMES_V1 — keep in sync with
    //   static/js/oee_machine_operator.js  (MACHINE_OEE_SHIFT_TIMES_V11)
    // ============================================================
    var SHIFT_TIMES = {
      "Shift 1": { start: "08:00:00", end: "19:00:00" },
      "Shift 2": { start: "19:00:00", end: "06:00:00" }
    };
    function _timeToMin(t) {
      if (!t) return null;
      var p = String(t).split(":");
      var h = parseInt(p[0], 10), m = parseInt(p[1] || "0", 10);
      if (isNaN(h) || isNaN(m)) return null;
      return h * 60 + m;
    }
    function _fmtMin(v) {
      var h = Math.floor(v / 60), m = v % 60;
      return h > 0 ? (h + "h " + (m ? m + "m" : "")).trim() : (m + " min");
    }
    
    function _normalizeShiftName(name) {
      if (!name) return null;
      var s = String(name).trim().toLowerCase();
      if (s === "shift 1" || s === "shift1" || s === "1st" || s === "1"
          || s === "day" || s === "day shift" || s === "shift-1") return "Shift 1";
      if (s === "shift 2" || s === "shift2" || s === "2nd" || s === "2"
          || s === "night" || s === "night shift" || s === "shift-2") return "Shift 2";
      // Fall back: try exact match to SHIFT_TIMES keys
      if (typeof SHIFT_TIMES !== "undefined" && SHIFT_TIMES[name]) return name;
      return null;
    }
    
    function computeShiftDistribution(rec) {
      if (!rec) return null;
      var rawShiftName = rec.shift_name || rec.shift;
      var shiftName = _normalizeShiftName(rawShiftName);
      var shift = shiftName ? SHIFT_TIMES[shiftName] : null;
      if (!shift) return null;
      var startTime = rec.start_time || rec.session_start_time || rec.entry_start_time;
      var endTime   = rec.end_time   || rec.session_end_time   || rec.entry_end_time;
      if (!startTime || !endTime) return null;
      var entryStart = _timeToMin(startTime);
      var entryEnd   = _timeToMin(endTime);
      var shiftStart = _timeToMin(shift.start);
      var shiftEnd   = _timeToMin(shift.end);
      if (entryStart == null || entryEnd == null) return null;
      // Handle Shift 2 crossing midnight
      if (shiftEnd < shiftStart) {
        shiftEnd += 1440;
        if (entryStart < shiftStart - 720) entryStart += 1440; // morning-of-next-day
        if (entryEnd   < shiftStart - 720) entryEnd   += 1440;
      }
      if (entryEnd < entryStart) entryEnd += 1440; // entry crosses midnight
      var before  = Math.max(0, Math.min(entryEnd, shiftStart) - entryStart);
      var inShift = Math.max(0, Math.min(entryEnd, shiftEnd) - Math.max(entryStart, shiftStart));
      var after   = Math.max(0, entryEnd - shiftEnd);
      return {
        shiftName: shiftName,
        shiftWindow: shift.start.slice(0,5) + " - " + shift.end.slice(0,5),
        entryStart: String(startTime).slice(0,5),
        entryEnd:   String(endTime).slice(0,5),
        total: entryEnd - entryStart,
        before: before, inShift: inShift, after: after
      };
    }
    function renderShiftDistribution(rec) {
      var d = computeShiftDistribution(rec);
      if (!d) return "";
      if (d.before === 0 && d.after === 0) return ""; // fully inside shift
      var rows = "";
      if (d.before > 0) {
        rows += '<tr><td class="lbl">Before ' + d.shiftName + '</td>' +
                '<td class="num">' + d.before + ' min</td>' +
                '<td class="sub">outside shift window</td></tr>';
      }
      rows += '<tr class="hi"><td class="lbl">In ' + d.shiftName + '</td>' +
              '<td class="num">' + d.inShift + ' min</td>' +
              '<td class="sub">counted in shift capacity</td></tr>';
      if (d.after > 0) {
        rows += '<tr><td class="lbl">After ' + d.shiftName + '</td>' +
                '<td class="num">' + d.after + ' min</td>' +
                '<td class="sub">outside shift window</td></tr>';
      }
      return "<div class='erp-section'>" +
        "<div class='erp-sec-title'><i class='fa fa-clock-o'></i>Shift Distribution</div>" +
        "<div class='shift-dist-sub'>Entry " + d.entryStart + " – " + d.entryEnd +
        " (" + d.total + " min) · " + d.shiftName + " window " + d.shiftWindow + "</div>" +
        "<table class='shift-dist-tbl'><tbody>" + rows + "</tbody></table>" +
        "</div>";
    }

