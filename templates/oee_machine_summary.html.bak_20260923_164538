{% extends "base.html" %} {% block title %}OEE Summary{% endblock %} {% block
extra_head %}
<style>
  :root {
    --tp: #1f272e;
    --ts: #6c7680;
    --tm: #8d97a1;
    --bd: #e2e6ea;
    --rl: #f5f7fa;
    --rh: #fbfcfd;
    --ac: #2490ef;
  }
  .oees-wrap {
    max-width: 1500px;
    margin: 0 auto;
    padding: 18px 22px;
    font-family:
      "IBM Plex Sans",
      -apple-system,
      "Segoe UI",
      Roboto,
      Arial,
      sans-serif;
    color: var(--tp);
    font-size: 13px;
    line-height: 1.45;
  }
  .oees-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .oees-title {
    margin: 0;
    font-size: 20px;
    font-weight: 700;
    color: var(--tp);
    letter-spacing: -0.01em;
  }
  .oees-sub {
    margin-top: 2px;
    font-size: 12px;
    color: var(--ts);
  }
  .oees-preset-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 12px 0 10px;
  }
  .oees-preset {
    height: 26px;
    padding: 0 12px;
    border: 1px solid var(--bd);
    background: var(--card);
    color: var(--tp);
    font-family: inherit;
    font-size: 12px;
    font-weight: 500;
    border-radius: 14px;
    cursor: pointer;
  }
  .oees-preset:hover {
    background: var(--rh);
  }
  .oees-preset.active {
    background: var(--ac);
    color: var(--card);
    border-color: var(--ac);
  }
  .oees-filters {
    background: var(--card);
    border: 1px solid var(--bd);
    border-radius: var(--radius-md);
    padding: 10px 22px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 12px;
    align-items: flex-end;
    margin-bottom: 10px;
  }
  .oees-fld {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .oees-fld label {
    font-size: 11px;
    font-weight: 500;
    color: var(--ts);
    text-transform: none;
    letter-spacing: 0;
  }
  .oees-fld input,
  .oees-fld select {
    height: 28px;
    padding: 0 8px;
    border: 1px solid var(--bd);
    border-radius: var(--radius-xs);
    font-family: inherit;
    font-size: 12.5px;
    color: var(--tp);
    background: var(--card);
    min-width: 130px;
  }
  .oees-fld input:focus,
  .oees-fld select:focus {
    outline: none;
    border-color: var(--ac);
    box-shadow: 0 0 0 2px rgba(11, 95, 165, 0.1);
  }
  .oees-btn {
    height: 28px;
    padding: 0 12px;
    border: 1px solid var(--ac);
    background: var(--ac);
    color: var(--card);
    border-radius: var(--radius-xs);
    font-family: inherit;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
  }
  .oees-btn i {
    margin-right: 6px;
  }
  .oees-btn:hover {
    filter: brightness(0.95);
  }
  .oees-btn.ghost {
    background: var(--card);
    color: var(--ac);
  }
  .oees-stats {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px 6px;
    padding: 10px 14px;
    margin-bottom: 14px;
    background: var(--card);
    border: 1px solid var(--bd);
    border-radius: var(--radius-md);
    font-size: 12px;
    color: var(--ts);
    font-variant-numeric: tabular-nums;
  }
  .oees-stats .k {
    font-weight: 700;
    color: var(--tp);
  }
  .oees-stats .sep {
    color: var(--bd);
    padding: 0 6px;
  }
  .oees-stats i {
    color: var(--tm);
    margin: 0 4px 0 2px;
  }
  .oees-grid-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    margin-bottom: 14px;
  }
  .oees-grid-single {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
    margin-bottom: 14px;
  }
  @media (max-width: 1000px) {
    .oees-grid-top {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .oees-card {
    background: var(--card);
    border: 1px solid var(--bd);
    border-radius: var(--radius-lg);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    overflow: hidden;
  }
  .oees-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--bd);
  }
  .oees-card-head .left {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .oees-card-head .icon {
    width: 26px;
    height: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--rl);
    border: 1px solid var(--bd);
    border-radius: var(--radius-md);
    color: var(--ac);
    font-size: 13px;
  }
  .oees-card-head strong {
    font-size: 13px;
    font-weight: 700;
    color: var(--tp);
  }
  .oees-count {
    font-size: 11px;
    font-weight: 700;
    color: var(--tm);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .oees-card-body {
    max-height: 340px;
    overflow: auto;
  }
  .oees-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 12.5px;
  }
  .oees-table thead th {
    position: sticky;
    top: 0;
    z-index: 2;
    background: var(--rl);
    padding: 9px 12px;
    text-align: left;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tm);
    border-bottom: 1px solid var(--bd);
    white-space: nowrap;
    box-shadow: inset 0 -1px 0 var(--bd);
  }
  .oees-table thead th.num {
    text-align: right;
  }
  .oees-table tbody td {
    padding: 9px 12px;
    border-bottom: 1px solid #eef2f7;
    color: var(--tp);
    white-space: nowrap;
    vertical-align: middle;
  }
  .oees-table tbody td.num {
    text-align: right;
    font-variant-numeric: tabular-nums;
    font-family: "IBM Plex Mono", ui-monospace, Menlo, Consolas, monospace;
    font-size: 12px;
  }
  .oees-table tbody tr:hover td {
    background: var(--rh);
  }
  .oees-table tbody tr.click {
    cursor: pointer;
  }
  .oees-table tbody tr:last-child td {
    border-bottom: 0;
  }
  .oees-empty,
  .oees-loading {
    padding: 30px;
    text-align: center;
    color: var(--tm);
    font-size: 12px;
  }
  .oee-val {
    font-weight: 700;
    color: var(--tp);
  }

  tr.dategrp td {
    background: #eef3fa !important;
    padding: 6px 12px !important;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tp);
    border-bottom: 1px solid var(--bd);
  }
  tr.dategrp td .meta {
    color: var(--tm);
    font-weight: 600;
    margin-left: 8px;
    text-transform: none;
    letter-spacing: 0;
  }

  .oee-cell {
    font-weight: 700;
    color: var(--tp);
  }
  .oee-cell::before {
    content: none;
  }
  .pct-cell {
    color: var(--tp);
  }
  .pct-cell::before {
    content: none;
  }

  /* --- Top Losses layout fix (Step 1) --- */
  table.oees-table#tbl-losses {
    table-layout: fixed;
    width: 100%;
  }
  #tbl-losses th,
  #tbl-losses td {
    vertical-align: middle;
  }
  #tbl-losses th:nth-child(1),
  #tbl-losses td:nth-child(1) {
    width: 56px;
  }
  #tbl-losses th:nth-child(3),
  #tbl-losses td:nth-child(3) {
    width: 60px;
  }
  #tbl-losses th:nth-child(4),
  #tbl-losses td:nth-child(4) {
    width: 110px;
  }
  #tbl-losses td:nth-child(2) {
    white-space: normal;
    word-break: break-word;
    line-height: 1.25;
    padding-right: 6px;
  }
  #tbl-losses td.num .loss-bar-wrap {
    display: block;
    width: 100%;
    text-align: right;
    padding: 2px 6px;
    font-weight: 600;
    color: var(--tp);
    font-variant-numeric: tabular-nums;
  }
  #tbl-losses td.num .loss-bar-wrap::before {
    content: none;
  }

  .loss-bar-wrap {
    display: inline-block;
    min-width: 40px;
    text-align: right;
    font-weight: 600;
    color: var(--tp);
    font-variant-numeric: tabular-nums;
  }
  .loss-bar-wrap::before {
    content: none;
  }

  .uid-mono {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 11.5px;
    color: var(--tp);
  }
  .shift-tag {
    display: inline-block;
    padding: 1px 7px;
    background: var(--rl);
    border: 1px solid var(--bd);
    border-radius: var(--radius-xs);
    color: var(--ts);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .type-tag {
    display: inline-block;
    padding: 2px 8px;
    border-left: 2px solid var(--tm);
    color: var(--ts);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .type-tag.t-ml {
    border-left-color: #a35c68;
  }
  .type-tag.t-tr {
    border-left-color: #4a7ba8;
  }
  .type-tag.t-dv {
    border-left-color: #6b7a90;
  }
  .cat-pill {
    display: inline-block;
    padding: 1px 6px;
    border: 1px solid var(--bd);
    border-radius: var(--radius-xs);
    font-size: 10px;
    font-weight: 700;
    color: var(--ts);
    background: var(--card);
    letter-spacing: 0.04em;
  }
  .loss-code {
    display: inline-block;
    padding: 1px 8px;
    border: 1px solid var(--bd);
    border-radius: var(--radius-xs);
    background: var(--card);
    color: var(--tp);
    font-size: 11px;
    font-weight: 700;
    min-width: 34px;
    text-align: center;
  }

  .oee-drill-overlay {
    position: fixed;
    inset: 0;
    background: rgba(15, 30, 60, 0.35);
    z-index: 900;
    opacity: 0;
    transition: opacity 0.18s ease;
    pointer-events: none;
  }
  .oee-drill-overlay.open {
    opacity: 1;
    pointer-events: auto;
  }
  .oee-drill-panel {
    position: fixed;
    top: 0;
    right: 0;
    height: 100vh;
    width: 640px;
    max-width: 100vw;
    background: var(--card);
    border-left: 1px solid var(--bd);
    box-shadow: -12px 0 32px rgba(0, 0, 0, 0.1);
    z-index: 1000;
    transform: translateX(100%);
    transition: transform 0.22s ease;
    display: flex;
    flex-direction: column;
  }
  .oee-drill-panel.open {
    transform: translateX(0);
  }
  .oee-drill-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--bd);
    background: var(--rl);
  }
  .oee-drill-eyebrow {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tm);
    margin-bottom: 4px;
  }
  .oee-drill-title {
    font-size: 15px;
    font-weight: 700;
    color: var(--tp);
    margin-bottom: 2px;
  }
  .oee-drill-sub {
    font-size: 12px;
    color: var(--ts);
  }
  .oee-drill-close {
    background: transparent;
    border: 0;
    font-size: 22px;
    line-height: 1;
    color: var(--tm);
    cursor: pointer;
    padding: 0 4px;
  }
  .oee-drill-close:hover {
    color: #b42318;
  }
  .oee-drill-body {
    flex: 1;
    overflow-y: auto;
    padding: 6px 0;
  }
  .oee-kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px 12px;
  }
  .oee-kpi-cell {
    padding: 8px 10px;
    background: var(--rl);
    border: 1px solid var(--bd);
    border-radius: var(--radius-md);
  }
  .oee-kpi-cell .k {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tm);
    margin-bottom: 4px;
  }
  .oee-kpi-cell .v {
    font-size: 14px;
    font-weight: 700;
    color: var(--tp);
    font-variant-numeric: tabular-nums;
  }
  .oee-drill-kv {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 6px 12px;
    font-size: 12px;
    margin: 0;
  }
  .oee-drill-kv dt {
    color: var(--tm);
    font-weight: 600;
  }
  .oee-drill-kv dd {
    margin: 0;
    color: var(--tp);
    font-weight: 500;
  }
  .oee-drill-kv dd.mono {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
  }
  .oee-drill-loss {
    display: grid;
    grid-template-columns: 46px 1fr 72px 46px;
    gap: 6px 10px;
    padding: 7px 0;
    border-bottom: 1px dashed var(--oee-border-soft);
    font-size: 12px;
    align-items: center;
  }
  .oee-drill-loss:last-child {
    border-bottom: 0;
  }
  .oee-drill-loss .mins {
    text-align: right;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    color: var(--tp);
  }
  .oee-drill-loss .cat {
    text-align: right;
    font-size: 10px;
    font-weight: 700;
    color: var(--tm);
  }
  .oee-drill-list-row {
    display: grid;
    grid-template-columns: 140px 1fr 130px;
    gap: 8px 12px;
    padding: 7px 0;
    border-bottom: 1px dashed var(--oee-border-soft);
    font-size: 12px;
    align-items: center;
  }
  .oee-drill-list-row:last-child {
    border-bottom: 0;
  }
  .oee-drill-list-row .lhs {
    color: var(--ts);
    font-family: "IBM Plex Mono", monospace;
    font-size: 11px;
  }
  .oee-drill-list-row .mid {
    color: var(--tp);
  }
  .oee-drill-list-row .rhs {
    color: var(--ts);
    text-align: right;
    font-size: 11px;
  }

  .uid-hero {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    background: linear-gradient(135deg, #f7fbff, var(--rl));
    border: 1px solid var(--bd);
    border-radius: var(--radius-lg);
    margin: 14px 18px 4px;
  }
  .uid-hero .iconbox {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-lg);
    background: var(--card);
    border: 1px solid var(--bd);
    color: var(--ac);
    font-size: 18px;
    flex-shrink: 0;
  }
  .uid-hero .big {
    font-size: 18px;
    font-weight: 700;
    font-family: "IBM Plex Mono", monospace;
    color: var(--tp);
    letter-spacing: 0.02em;
    word-break: break-all;
  }
  .uid-hero .small {
    font-size: 11px;
    color: var(--ts);
    margin-top: 2px;
  }

  .badge-status {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    background: #eaf5ec;
    color: #2d6a3d;
    border: 1px solid #c8e0cc;
  }
  .badge-status.b-inuse {
    background: #eaf0fb;
    color: #1a4380;
    border-color: #cadaf5;
  }
  .badge-status.b-scrap {
    background: #fce8ea;
    color: #8f2033;
    border-color: #f2c5cd;
  }
  .badge-status.b-regr {
    background: #fbf3e0;
    color: #7a5a10;
    border-color: #f0dfb6;
  }

  .mini-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .mini-item {
    display: grid;
    grid-template-columns: 110px 1fr 140px;
    gap: 8px 10px;
    padding: 8px 10px;
    background: var(--rl);
    border: 1px solid var(--bd);
    border-radius: var(--radius-md);
    font-size: 12px;
    align-items: center;
  }
  .mini-item .d {
    color: var(--tm);
    font-family: "IBM Plex Mono", monospace;
    font-size: 11px;
  }
  .mini-item .n {
    color: var(--tp);
    font-weight: 500;
  }
  .mini-item .a {
    text-align: right;
    color: var(--ts);
    font-size: 11px;
  }

  /* ERPNext .report-summary - compact inline strip (Patch 2b) */
  .report-summary {
    background: transparent;
    border: none;
    border-radius: 0;
    margin: 8px 22px 12px;
    padding: 6px 0;
    display: flex;
    flex-wrap: nowrap;
    align-items: baseline;
    gap: 22px;
    overflow-x: auto;
    border-bottom: 1px solid var(--bd);
  }
  .report-summary .summary-item {
    margin: 0;
    min-width: 0;
    max-width: none;
    height: auto;
    display: inline-flex;
    flex-direction: row;
    align-items: baseline;
    gap: 6px;
    white-space: nowrap;
  }
  .report-summary .summary-label {
    font-size: 10px;
    color: var(--ts);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
    text-align: left;
  }
  .report-summary .summary-value {
    font-size: 14px;
    font-weight: 600;
    color: var(--tp);
    font-feature-settings: "tnum";
    padding-top: 0;
    text-align: left;
    line-height: 1.2;
  }
  .report-summary .summary-value .u {
    font-size: 11px;
    color: var(--ts);
    font-weight: 500;
    margin-left: 1px;
  }
  .report-summary .summary-value.green { color: #29cd42; }
  .report-summary .summary-value.red   { color: #e74c3c; }
  .report-summary .summary-sep {
    width: 1px;
    height: 12px;
    background: var(--bd);
    align-self: center;
  }

  /* ERPNext DataTable style (Patch 4) */
  .oees-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 12.5px;
  }
  .oees-table thead th {
    background: #fbfcfd;
    color: var(--ts);
    text-align: left;
    font-weight: 600;
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 8px 10px;
    border-bottom: 1px solid var(--bd);
    position: sticky;
    top: 0;
    z-index: 3;
    white-space: nowrap;
  }
  .oees-table thead th.num { text-align: right; }
  .oees-table tbody td {
    padding: 6px 10px;
    height: 30px;
    border-bottom: 1px solid #f0f2f5;
    vertical-align: middle;
    color: var(--tp);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .oees-table tbody td.num {
    text-align: right;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .oees-table tbody tr { transition: background .08s; }
  .oees-table tbody tr:hover td { background: #f8fbfe; }
  .oees-table tbody tr.dategrp td,
  .oees-table tbody tr.date-group td,
  .oees-table tbody tr.oees-date-group td {
    background: #f4f7fb;
    color: var(--ts);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.03em;
    padding: 5px 10px;
    text-transform: uppercase;
  }

  .shift-dist { margin-top: 14px; border-top: 1px solid var(--bd); padding-top: 10px; }
  .shift-dist-h { font-size: 11px; font-weight: 600; color: var(--tp); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 4px; }
  .shift-dist-sub { font-size: 11px; color: var(--ts); margin-bottom: 8px; }
  .shift-dist-tbl { width: 100%; border-collapse: collapse; font-size: 12px; }
  .shift-dist-tbl td { padding: 5px 8px; border-bottom: 1px solid #f0f2f5; vertical-align: middle; }
  .shift-dist-tbl td.lbl { color: var(--tp); font-weight: 500; }
  .shift-dist-tbl td.num { text-align: right; font-family: "IBM Plex Mono", monospace; font-weight: 600; color: var(--tp); font-variant-numeric: tabular-nums; width: 90px; }
  .shift-dist-tbl td.sub { color: var(--ts); font-size: 11px; }
  .shift-dist-tbl tr.hi td { background: #eaf4fd; }
  .shift-dist-tbl tr.hi td.lbl { color: var(--ac); }

    /* shift-dist */
    .shift-dist-sub {
      font-size: 11px;
      color: var(--tm);
      margin: 0 0 8px 0;
    }
    .shift-dist-tbl {
      width: 100%;
      border-collapse: collapse;
