    function findLinkedEntry(entryId) {
      if (!entryId) return null;
      const s = (cache.sessions || []).find((x) => x.entry_id === entryId);
      if (s) return { kind: "session", data: s };
      const a = (cache.activities || []).find((x) => x.entry_id === entryId);
      if (a) return { kind: "activity", data: a };
      return null;
