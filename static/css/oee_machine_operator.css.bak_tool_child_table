   SINGLE_PAGE_HEADER_V60
   Sticky 3-row header for the single-page OEE operator view.
   All classes are namespaced with -v60 to avoid collisions.
   ========================================================= */


/* ── HEADER SHELL ──────────────────────────────────────── */

.oee-sph-v60 {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #ffffff;
    border-bottom: 2px solid #dfe5ed;
    box-shadow: 0 2px 8px rgba(23, 34, 53, .07);
}


/* ── ROW 1 : Machine tabs + KPI strip ─────────────────── */

.oee-sph-row1-v60 {
    display: flex;
    align-items: center;
    gap: 0;
    padding: 10px max(32px, calc((100% - 1120px) / 2));
    border-bottom: 1px solid #dfe5ed;
}


/* Machine tabs nav */

.oee-sph-tabs-v60 {
    display: flex;
    align-items: center;
    gap: 6px;
    flex: 1;
    overflow-x: auto;
    padding-right: 16px;
    scrollbar-width: none;
}

.oee-sph-tabs-v60::-webkit-scrollbar {
    display: none;
}


/* Individual tab pill */

.oee-sph-tab-v60 {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border: 1.5px solid #dfe5ed;
    border-radius: 999px;
    background: #ffffff;
    color: #475569;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
    text-decoration: none;
    font-family: "IBM Plex Sans", sans-serif;
    transition:
        border-color .15s,
        background .15s,
        color .15s;
}

.oee-sph-tab-v60:hover {
    border-color: #173d68;
    color: #173d68;
    text-decoration: none;
}

.oee-sph-tab-v60.active {
    background: #173d68;
    border-color: #173d68;
    color: #ffffff;
}


/* Status dot on each tab */

.oee-sph-tab-dot-v60 {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #94a3b8;
    flex-shrink: 0;
}

.oee-sph-tab-v60.active .oee-sph-tab-dot-v60 {
    background: #86efac;
