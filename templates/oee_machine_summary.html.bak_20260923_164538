<script>
  (function () {
    "use strict";
    const CAN_EXPORT = "{{ 'true' if can_export else 'false' }}" === "true";
    const API = "/api/oee-machine-summary";
    const DAY_NAMES = [
      "Sunday",
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday",
      "Saturday",
    ];
    let cache = {};
    let byId = {};


    function fmt(v, d) {
      if (v === null || v === undefined || v === "") return "\u2013";
      const n = Number(v);
      if (isNaN(n)) return "\u2013";
      if (d === undefined) return n.toLocaleString();
      return n.toLocaleString(undefined, {
        minimumFractionDigits: d,
        maximumFractionDigits: d,
      });
    }
    function fmtPct(v) {
      if (v === null || v === undefined) return "\u2013";
      return Number(v).toFixed(1) + "%";
    }
    function pad(n) {
      return n < 10 ? "0" + n : "" + n;
    }
    function isoDate(d) {
      return (
        d.getFullYear() + "-" + pad(d.getMonth() + 1) + "-" + pad(d.getDate())
      );
    }
    function firstOfMonth(d) {
      return new Date(d.getFullYear(), d.getMonth(), 1);
    }
    function clamp01(x) {
      return Math.max(0, Math.min(100, Number(x || 0)));
    }
    function dayName(dstr) {
      if (!dstr) return "";
      const d = new Date(dstr + "T00:00:00");
      if (isNaN(d.getTime())) return "";
      return DAY_NAMES[d.getDay()];
    }

    function qString() {
      const p = new URLSearchParams();
      const fd = ERP.$("#oees-from").value,
        td = ERP.$("#oees-to").value;
      if (fd) p.set("from_date", fd);
      if (td) p.set("to_date", td);
      const z = ERP.$("#oees-zone").value,
        m = ERP.$("#oees-machine").value,
        op = ERP.$("#oees-operator").value;
      if (z) p.set("zone", z);
      if (m) p.set("machine_id", m);
      if (op) p.set("operator_master_id", op);
      return p.toString();
    }

    function applyPreset(name) {
      const t = new Date();
      let fd, td;
      if (name === "today") {
        fd = new Date(t);
        td = new Date(t);
      } else if (name === "yesterday") {
        const y = new Date(t);
        y.setDate(y.getDate() - 1);
        fd = y;
        td = y;
      } else if (name === "this_week") {
        const day = (t.getDay() + 6) % 7;
        fd = new Date(t);
        fd.setDate(fd.getDate() - day);
        td = new Date(t);
      } else if (name === "last_week") {
        const day = (t.getDay() + 6) % 7;
        const thisStart = new Date(t);
        thisStart.setDate(thisStart.getDate() - day);
        td = new Date(thisStart);
        td.setDate(td.getDate() - 1);
        fd = new Date(td);
        fd.setDate(fd.getDate() - 6);
      } else if (name === "this_month") {
        fd = firstOfMonth(t);
        td = new Date(t);
      } else if (name === "last_month") {
        const firstThis = firstOfMonth(t);
        td = new Date(firstThis);
        td.setDate(td.getDate() - 1);
        fd = firstOfMonth(td);
      } else return;
      ERP.$("#oees-from").value = isoDate(fd);
      ERP.$("#oees-to").value = isoDate(td);
    }

    async function loadFilters() {
      try {
        const r = await fetch(API + "/filters");
        const d = await r.json();
        if (d.error) return;
        (d.zones || []).forEach((z) => {
          const o = document.createElement("option");
          o.value = z;
          o.textContent = z;
          ERP.$("#oees-zone").appendChild(o);
        });
        (d.machines || []).forEach((m) => {
          const o = document.createElement("option");
          o.value = m.id;
          o.textContent = m.machine_no + " \u2014 " + m.machine_name;
          ERP.$("#oees-machine").appendChild(o);
        });
        (d.operators || []).forEach((op) => {
          const o = document.createElement("option");
          o.value = op.id;
          o.textContent = op.employee_no + " \u2014 " + op.operator_name;
          ERP.$("#oees-operator").appendChild(o);
        });
      } catch (e) {
        console.error(e);
      }
    }

    async function loadFlat() {
      ERP.$("#body-sessions").innerHTML =
        "<tr><td colspan='12' class='oees-loading'>Loading...</td></tr>";
      ERP.$("#body-losses").innerHTML =
        "<tr><td colspan='4'  class='oees-loading'>Loading...</td></tr>";
      ERP.$("#body-activities").innerHTML =
        "<tr><td colspan='12' class='oees-loading'>Loading...</td></tr>";
      ERP.$("#body-tools").innerHTML =
        "<tr><td colspan='11' class='oees-loading'>Loading...</td></tr>";
      try {
        const r = await fetch(API + "/flat?" + qString());
        const d = await r.json();
        if (d.error) throw new Error(d.error);
        cache = d;
        byId = {};
        (d.sessions || []).forEach((s) => {
          byId["session-" + s.entry_id] = s;
        });
        (d.activities || []).forEach((a) => {
          byId["activity-" + a.entry_id] = a;
        });
        (d.tool_entries || []).forEach((t) => {
          byId["tool-" + t.tool_id] = t;
        });
        ERP.$("#oees-period-sub").textContent =
          "Showing " + d.period.from_date + " to " + d.period.to_date;
        renderStats(d.totals);
        renderSessions(d.sessions || []);
        renderTopLosses(d.top_losses || []);
        renderActivities(d.activities || []);
        renderToolEntries(d.tool_entries || []);
      } catch (e) {
        const msg = "Error: " + ERP.esc(e.message);
        ERP.$("#body-sessions").innerHTML =
          "<tr><td colspan='12' class='oees-empty'>" + msg + "</td></tr>";
        ERP.$("#body-losses").innerHTML =
          "<tr><td colspan='4'  class='oees-empty'>" + msg + "</td></tr>";
        ERP.$("#body-activities").innerHTML =
          "<tr><td colspan='12' class='oees-empty'>" + msg + "</td></tr>";
        ERP.$("#body-tools").innerHTML =
          "<tr><td colspan='10' class='oees-empty'>" + msg + "</td></tr>";
      }
    }

    function renderStats(t) {      if (!t) {
        ERP.$("#oees-stats-strip").innerHTML = '<div class="summary-item"><div class="summary-label">No data</div></div>';
        return;
      }
      var items = [
        { label: "Sessions",     value: fmt(t.session_count) },
        { label: "Avg OEE",      value: fmtPct(t.avg_oee_pct) },
        { label: "Planned",      value: fmt(t.total_planned, 0) + '<span class="u"> min</span>' },
        { label: "Utilised",     value: fmt(t.total_util, 0)    + '<span class="u"> min</span>' },
        { label: "OK Produced",  value: fmt(t.total_ok != null ? t.total_ok : (t.ok_qty || 0), 0), cls: "green" },
        { label: "Losses",       value: fmt(t.total_losses_min || 0, 0) + '<span class="u"> min</span>' },
        { label: "Activities",   value: fmt(t.activity_count || 0) },
        { label: "Tool Entries", value: fmt(t.tool_entry_count || 0) }
      ];
      ERP.$("#oees-stats-strip").innerHTML = items.map(function (it, i) {
        var sep = i > 0 ? '<div class="summary-sep"></div>' : '';
        return sep +
          '<div class="summary-item">' +
            '<div class="summary-label">' + it.label + '</div>' +
            '<div class="summary-value' + (it.cls ? ' ' + it.cls : '') + '">' + it.value + '</div>' +
          '</div>';
      }).join('');
    }

    function renderSessions(rows) {
      const body = ERP.$("#body-sessions");
      ERP.$("#c-sessions").textContent = rows.length + " rows";
      if (!rows.length) {
        body.innerHTML =
          "<tr><td colspan='12' class='oees-empty'>No sessions.</td></tr>";
        return;
      }
      // group by entry_date
      const groups = {};
      const order = [];
      rows.forEach((s) => {
        if (!groups[s.entry_date]) {
          groups[s.entry_date] = [];
          order.push(s.entry_date);
        }
        groups[s.entry_date].push(s);
      });
      let h = "";
      order.forEach((d) => {
        const arr = groups[d];
        const avgOee =
          arr.reduce((sum, x) => sum + Number(x.oee_pct || 0), 0) / arr.length;
        const dn = dayName(d);
        h +=
          "<tr class='dategrp'><td colspan='12'>" +
          ERP.esc(d) +
          (dn ? " \u00b7 " + ERP.esc(dn) : "") +
          " <span class='meta'>" +
          arr.length +
          " sessions \u00b7 avg OEE " +
          avgOee.toFixed(1) +
          " %</span></td></tr>";
        arr.forEach((s) => {
          h +=
            "<tr class='click' data-key='session-" +
            s.entry_id +
            "'>" +
            "<td><span class='erp-badge' data-status='muted'>" +
            ERP.esc(s.shift_name) +
            "</span></td>" +
            "<td>" +
            ERP.esc(((s.machine_no || "") + " " + (s.machine_name || "")).trim()) +
            "</td>" +
            "<td>" +
            ERP.esc(s.operator_name || "") +
            "</td>" +
            "<td>" +
            ERP.esc(s.job_card_no || "") +
            "</td>" +
            "<td class='num'>" +
            fmt(s.ok_qty) +
            "</td>" +
            "<td class='num'>" +
            fmt(s.planned_minutes, 1) +
            "</td>" +
            "<td class='num'>" +
            fmt(s.utilization_minutes, 1) +
            "</td>" +
            "<td class='num'>" +
            fmt(s.run_minutes, 1) +
            "</td>" +
            "<td class='num'><span class='pct-cell' style='--w:" +
            clamp01(s.ar_pct) +
            "%'>" +
            fmtPct(s.ar_pct) +
            "</span></td>" +
            "<td class='num'><span class='pct-cell' style='--w:" +
            clamp01(s.pr_pct) +
            "%'>" +
            fmtPct(s.pr_pct) +
            "</span></td>" +
            "<td class='num'><span class='pct-cell' style='--w:" +
            clamp01(s.qr_pct) +
            "%'>" +
            fmtPct(s.qr_pct) +
            "</span></td>" +
            "<td class='num'><span class='oee-cell' style='--w:" +
            clamp01(s.oee_pct) +
            "%'>" +
            fmtPct(s.oee_pct) +
            "</span></td>" +
            "</tr>";
        });
      });
      body.innerHTML = h;
      body
        .querySelectorAll("tr.click")
        .forEach((tr) =>
          tr.addEventListener("click", () => openDrill(tr.dataset.key)),
        );
    }

    function renderTopLosses(rows) {
      const body = ERP.$("#body-losses");
      ERP.$("#c-losses").textContent = rows.length + " rows";
      if (!rows.length) {
        body.innerHTML =
          "<tr><td colspan='4' class='oees-empty'>No losses.</td></tr>";
        return;
      }
      const maxMin = Math.max.apply(
        null,
        rows.map((r) => Number(r.total_min || 0)).concat([1]),
      );
      let h = "";
      rows.forEach((l) => {
        const w = Math.max(2, (Number(l.total_min || 0) / maxMin) * 100);
        h +=
          "<tr>" +
          "<td><span class='loss-code'>" +
          ERP.esc(l.code) +
          "</span></td>" +
          "<td>" +
          ERP.esc(l.name || "") +
          "</td>" +
          "<td><span class='erp-badge' data-status='muted'>" +
          ERP.esc(l.category) +
          "</span></td>" +
          "<td class='num'><span class='loss-bar-wrap' style='--w:" +
          w.toFixed(0) +
          "%'>" +
          fmt(l.total_min, 1) +
          "</span></td>" +
          "</tr>";
      });
      body.innerHTML = h;
    }

    function typeTag(t) {
      const u = String(t || "").toUpperCase();
      if (u === "MACHINE_LOSS")
        return "<span class='erp-badge' data-status='err'>Machine Loss</span>";
      if (u === "TOOL_ROOM")
        return "<span class='erp-badge' data-status='info'>Tool Room</span>";
      if (u === "DEVELOPMENT")
        return "<span class='erp-badge' data-status='muted'>Development</span>";
      return "<span class='erp-badge' data-status='muted'>" + ERP.esc(u) + "</span>";
    }
    function typeLabel(t) {
      const u = String(t || "").toUpperCase();
      if (u === "MACHINE_LOSS") return "Machine Loss";
      if (u === "TOOL_ROOM") return "Tool Room";
      if (u === "DEVELOPMENT") return "Development";
      return u;
    }

    function renderActivities(rows) {
      const body = ERP.$("#body-activities");
      ERP.$("#c-activities").textContent = rows.length + " rows";
      if (!rows.length) {
        body.innerHTML =
          "<tr><td colspan='12' class='oees-empty'>No activities.</td></tr>";
        return;
      }
      let h = "";
      rows.forEach((a) => {
        h +=
          "<tr class='click' data-key='activity-" +
          a.entry_id +
          "'>" +
          "<td>" +
          ERP.esc(a.entry_date) +
          "</td>" +
          "<td><span class='erp-badge' data-status='muted'>" +
          ERP.esc(a.shift_name) +
          "</span></td>" +
          "<td>" +
          typeTag(a.activity_type) +
          "</td>" +
          "<td>" +
          ERP.esc(a.activity_name || "") +
          "</td>" +
          "<td>" +
          ERP.esc(((a.machine_no || "") + " " + (a.machine_name || "")).trim()) +
          "</td>" +
          "<td>" +
          ERP.esc(a.operator_name || "") +
          "</td>" +
          "<td>" +
          ERP.esc(a.start_time || "") +
          "</td>" +
          "<td>" +
          ERP.esc(a.end_time || "") +
          "</td>" +
          "<td class='num'>" +
          fmt(a.planned_minutes, 1) +
          "</td>" +
          "<td class='num'>" +
          fmt(a.utilization_minutes, 1) +
          "</td>" +
          "<td class='num'>" +
          fmt(a.ar_loss_minutes, 1) +
          "</td>" +
          "<td class='num'>" +
          fmt(a.pr_loss_minutes, 1) +
          "</td>" +
          "</tr>";
      });
      body.innerHTML = h;
      body
        .querySelectorAll("tr.click")
        .forEach((tr) =>
          tr.addEventListener("click", () => openDrill(tr.dataset.key)),
        );
    }

    function renderToolEntries(rows) {
      const body = ERP.$("#body-tools");

      ERP.$("#c-tools").textContent =
        rows.length + " rows";

      if (!rows.length) {
        body.innerHTML =
          "<tr><td colspan='11' class='oees-empty'>No tool entries.</td></tr>";

        return;
      }

      let h = "";

      rows.forEach((t) => {

        const toolLife =
          t.tool_life === null
          || t.tool_life === undefined
          || t.tool_life === ""
            ? ""
            : fmt(t.tool_life, 3);

        h +=
          "<tr class='click' data-key='tool-" +
          t.tool_id +
          "'>" +

          "<td>" +
          ERP.esc(t.entry_date || "") +
          "</td>" +

          "<td><span class='erp-badge' data-status='muted'>" +
          ERP.esc(t.shift_name || "") +
          "</span></td>" +

          "<td>" +
          ERP.esc(t.job_card_no || "") +
